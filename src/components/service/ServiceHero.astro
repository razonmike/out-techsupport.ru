---
import ArrowRight from 'phosphor-astro/ArrowRight.astro';

interface Feature {
  label: string;
  desc: string;
  icon?: any;
}

interface Props {
  title: string;
  lead: string;
  features?: Feature[];
  primaryCta?: { label: string; href: string };
  secondaryCta?: { label: string; href: string };
}

const {
  title,
  lead,
  features = [],
  primaryCta = { label: 'Обсудить задачу', href: '#contacts' },
  secondaryCta = { label: 'Посмотреть тарифы', href: '/#prices' },
} = Astro.props;
---

<section class="service-hero section-with-bg">
  <div class="container service-hero-inner">
    <div class="service-hero-left reveal">
      <h1 class="service-hero-title">{title}</h1>
      <p class="service-hero-lead">{lead}</p>
      <div class="service-hero-actions">
        <a class="btn btn-primary" href={primaryCta.href}>
          {primaryCta.label} <ArrowRight width={16} height={16} />
        </a>
        <a class="btn btn-secondary" href={secondaryCta.href}>{secondaryCta.label}</a>
      </div>
    </div>
    {features.length > 0 && (
      <div class="service-hero-right reveal">
        <div class="service-hero-features">
          {features.map((f) => (
            <div class="service-hero-feature">
              {f.icon && <f.icon class="service-hero-feature-icon" width={24} height={24} />}
              <div>
                <div class="service-hero-feature-label">{f.label}</div>
                <div class="service-hero-feature-desc">{f.desc}</div>
              </div>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .service-hero {
    padding: 80px 0 60px;
  }
  .service-hero-inner {
    display: grid;
    grid-template-columns: 1.1fr 1fr;
    gap: 48px;
    align-items: start;
  }
  .service-hero-title {
    font-size: clamp(1.9rem, 3.2vw, 2.9rem);
    font-weight: 600;
    line-height: 1.12;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
    color: var(--text);
  }
  .service-hero-lead {
    font-size: 1.1rem;
    line-height: 1.55;
    color: var(--muted);
    font-weight: 300;
    margin: 0 0 28px;
    max-width: 560px;
  }
  .service-hero-actions {
    display: flex;
    gap: 12px;
    flex-wrap: wrap;
  }
  .service-hero-right {
    background: var(--card);
    border: 1px solid var(--stroke);
    border-radius: 2px;
    padding: 24px;
  }
  .service-hero-features {
    display: grid;
    gap: 16px;
  }
  .service-hero-feature {
    display: flex;
    gap: 14px;
    align-items: flex-start;
  }
  .service-hero-feature :global(.service-hero-feature-icon) {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }
  .service-hero-feature-label {
    font-weight: 600;
    font-size: 0.98rem;
    color: var(--text);
    margin-bottom: 2px;
  }
  .service-hero-feature-desc {
    font-size: 0.88rem;
    line-height: 1.45;
    color: var(--muted);
    font-weight: 300;
  }

  @media (max-width: 980px) {
    .service-hero-inner {
      grid-template-columns: 1fr;
      gap: 32px;
    }
  }
  @media (max-width: 720px) {
    .service-hero {
      padding: 56px 0 40px;
    }
    .service-hero-actions {
      flex-direction: column;
    }
    .service-hero-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
