---
interface Step {
  title: string;
  desc: string;
}

interface Props {
  heading?: string;
  intro?: string;
  steps: Step[];
}

const { heading = 'Как мы работаем', intro, steps } = Astro.props;
---

<section class="section section-with-bg">
  <div class="container">
    <h2>{heading}</h2>
    {intro && <p class="section-intro reveal">{intro}</p>}
    <div class="process-grid">
      {steps.map((step, i) => (
        <div class="process-step reveal">
          <span class="process-number">{i + 1}</span>
          <h3>{step.title}</h3>
          <p>{step.desc}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .process-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 14px;
  }
  .process-step {
    background: var(--card);
    border: 1px solid var(--stroke);
    border-radius: 2px;
    padding: 22px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .process-number {
    width: 34px;
    height: 34px;
    display: inline-grid;
    place-items: center;
    font-family: "Space Mono", monospace;
    font-size: 0.85rem;
    font-weight: 700;
    color: #071c26;
    background: var(--accent);
    margin-bottom: 6px;
  }
  .process-step h3 {
    font-size: 1rem;
    margin: 0;
  }
  .process-step p {
    margin: 0;
    color: var(--muted);
    font-weight: 300;
    line-height: 1.45;
    font-size: 0.92rem;
  }

  @media (max-width: 980px) {
    .process-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 540px) {
    .process-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
