---
import ArrowRight from 'phosphor-astro/ArrowRight.astro';

interface Props {
  heading?: string;
  text?: string;
  primary?: { label: string; href: string };
  secondary?: { label: string; href: string };
}

const {
  heading = 'Готовы обсудить задачу?',
  text = 'Разберём вашу ситуацию, предложим формат работы и зафиксируем понятные сроки. Первичная консультация и аудит - бесплатно.',
  primary = { label: 'Оставить заявку', href: '/#contacts' },
  secondary = { label: 'Посмотреть тарифы', href: '/#prices' },
} = Astro.props;
---

<section class="section section-with-bg final-cta">
  <div class="container final-cta-inner reveal">
    <h2>{heading}</h2>
    <p>{text}</p>
    <div class="final-cta-actions">
      <a class="btn btn-primary" href={primary.href}>
        {primary.label} <ArrowRight width={16} height={16} />
      </a>
      <a class="btn btn-secondary" href={secondary.href}>{secondary.label}</a>
    </div>
  </div>
</section>

<style>
  .final-cta {
    padding: 72px 0;
  }
  .final-cta-inner {
    max-width: 760px;
    margin: 0 auto;
    text-align: center;
    border: 1px solid var(--stroke);
    background: var(--card);
    padding: 48px 36px;
    border-radius: 2px;
  }
  .final-cta-inner h2 {
    text-align: center;
    margin-bottom: 14px;
  }
  .final-cta-inner p {
    color: var(--muted);
    font-weight: 300;
    line-height: 1.55;
    margin: 0 0 26px;
    font-size: 1.05rem;
  }
  .final-cta-actions {
    display: inline-flex;
    gap: 12px;
    flex-wrap: wrap;
    justify-content: center;
  }
  @media (max-width: 540px) {
    .final-cta-inner {
      padding: 36px 22px;
    }
    .final-cta-actions {
      width: 100%;
      flex-direction: column;
    }
    .final-cta-actions :global(.btn) {
      width: 100%;
    }
  }
</style>
