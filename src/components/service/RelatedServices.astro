---
import ArrowRight from 'phosphor-astro/ArrowRight.astro';

interface Props {
  currentSlug: string;
}

const { currentSlug } = Astro.props;

const all = [
  { slug: 'it-outsourcing', title: 'IT-аутсорсинг', desc: 'Внешний IT-отдел: абонентское сопровождение всей инфраструктуры.' },
  { slug: 'wifi', title: 'Организация Wi-Fi', desc: 'Стабильный корпоративный Wi-Fi без мёртвых зон.' },
  { slug: 'video-surveillance', title: 'Видеонаблюдение и СКУД', desc: 'Безопасность объектов и контроль доступа.' },
  { slug: '1c', title: 'Поддержка 1С', desc: 'Развёртывание, оптимизация, бэкапы и поддержка.' },
  { slug: 'virtualization', title: 'Виртуализация', desc: 'Hyper-V, VMware, Proxmox - оптимизация серверов.' },
  { slug: 'system-administration', title: 'Системное администрирование', desc: 'Мониторинг, обновления, безопасность, инциденты.' },
  { slug: 'devops', title: 'DevOps', desc: 'Автоматизация выпуска и эксплуатации сервисов.' },
  { slug: 'software-development', title: 'Разработка ПО', desc: 'Интеграции, боты, веб-приложения под задачи бизнеса.' },
  { slug: 'ai', title: 'Внедрение AI', desc: 'Ассистенты, обработка документов, AI-агенты в процессах.' },
];

const related = all.filter((s) => s.slug !== currentSlug).slice(0, 3);
---

<section class="section section-with-bg">
  <div class="container">
    <h2>Другие услуги</h2>
    <div class="related-grid">
      {related.map((s) => (
        <a class="card related-card reveal" href={`/services/${s.slug}/`}>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <span class="related-link">Перейти <ArrowRight width={14} height={14} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .related-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
  }
  .related-card {
    display: flex;
    flex-direction: column;
    gap: 8px;
    color: inherit;
    text-decoration: none;
    padding: 22px;
  }
  .related-card h3 {
    font-size: 1.05rem;
    margin: 0;
  }
  .related-link {
    margin-top: auto;
    padding-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
  }
  .related-card:hover .related-link {
    gap: 10px;
  }
  @media (max-width: 980px) {
    .related-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
