---
import Phone from 'phosphor-astro/Phone.astro';
import EnvelopeSimple from 'phosphor-astro/EnvelopeSimple.astro';
import PaperPlaneTilt from 'phosphor-astro/PaperPlaneTilt.astro';
import DownloadSimple from 'phosphor-astro/DownloadSimple.astro';
import CheckCircle from 'phosphor-astro/CheckCircle.astro';
import Clock from 'phosphor-astro/Clock.astro';
import MapPin from 'phosphor-astro/MapPin.astro';
---

<section id="contacts" class="section section-with-bg contacts">
  <div class="container contacts-grid">
    <div class="contacts-left reveal">
      <h2>Обсудим ваш проект</h2>
      <p class="contacts-lead">
        Оставьте контакты - или напишите напрямую. Предложим формат поддержки,
        который снизит нагрузку на вашу команду и стабилизирует ключевые IT-сервисы.
      </p>

      <div class="contacts-direct">
        <a class="contacts-direct-item" href="tel:+79656093153">
          <Phone class="contacts-direct-icon" width={20} height={20} />
          <div>
            <div class="contacts-direct-label">Телефон</div>
            <div class="contacts-direct-value">+7 (965) 609-31-53</div>
          </div>
        </a>
        <a class="contacts-direct-item" href="mailto:support@out-techsupport.ru">
          <EnvelopeSimple class="contacts-direct-icon" width={20} height={20} />
          <div>
            <div class="contacts-direct-label">Почта</div>
            <div class="contacts-direct-value">support@out-techsupport.ru</div>
          </div>
        </a>
        <a class="contacts-direct-item" href="https://t.me/outtechsupport" target="_blank" rel="noopener">
          <PaperPlaneTilt class="contacts-direct-icon" width={20} height={20} />
          <div>
            <div class="contacts-direct-label">Telegram</div>
            <div class="contacts-direct-value">@outtechsupport</div>
          </div>
        </a>
        <a class="contacts-direct-item contacts-direct-download" href="/downloads/TechSupport.exe">
          <DownloadSimple class="contacts-direct-icon" width={20} height={20} />
          <div>
            <div class="contacts-direct-label">Помощь сейчас</div>
            <div class="contacts-direct-value">Скачать клиент удалённого доступа TechSupport</div>
          </div>
        </a>
      </div>

      <ul class="contacts-reassure">
        <li>
          <CheckCircle class="contacts-check" width={16} height={16} />
          <span>Первичный аудит инфраструктуры - бесплатно</span>
        </li>
        <li>
          <CheckCircle class="contacts-check" width={16} height={16} />
          <span>Работаем с юр. лицами и ИП, закрывающие документы</span>
        </li>
        <li>
          <CheckCircle class="contacts-check" width={16} height={16} />
          <span>Минимальный срок договора - 1 месяц, без долгих обязательств</span>
        </li>
      </ul>

      <div class="contacts-meta">
        <span class="contacts-meta-item">
          <Clock class="contacts-meta-icon" width={15} height={15} />
          Пн-Пт · 9:00-19:00 МСК
        </span>
        <span class="contacts-meta-item">
          <MapPin class="contacts-meta-icon" width={15} height={15} />
          Казань, работаем по РТ и регионам
        </span>
      </div>
    </div>

    <form class="contact-form reveal" id="contact-form" novalidate>
      <label>Имя
        <input type="text" name="name" id="cf-name" placeholder="Ваше имя" required autocomplete="name" maxlength="120">
      </label>
      <label>Телефон
        <input type="tel" name="phone" id="cf-phone" placeholder="+7 (___) ___-__-__" required autocomplete="tel" maxlength="40" inputmode="tel">
      </label>
      <label>Email <span class="cf-optional">(не обязательно)</span>
        <input type="email" name="email" id="cf-email" placeholder="you@company.ru" autocomplete="email" maxlength="120" inputmode="email">
      </label>
      <label>Комментарий
        <textarea name="comment" id="cf-comment" rows="4" placeholder="Коротко опишите задачу" maxlength="2000"></textarea>
      </label>
      <label class="cf-honeypot" aria-hidden="true">
        Сайт
        <input type="text" name="website" tabindex="-1" autocomplete="off">
      </label>
      <label class="cf-consent">
        <input type="checkbox" name="consent" id="cf-consent" required>
        <span>Согласен на обработку персональных данных в соответствии с <a href="/privacy" target="_blank" rel="noopener">политикой конфиденциальности</a>.</span>
      </label>
      <button class="btn" type="submit" id="cf-submit">Получить консультацию</button>
      <p class="form-status" id="cf-status" role="status" aria-live="polite"></p>
      <p class="form-note">Ответим в рабочее время и предложим варианты запуска работ под ваш бюджет.</p>
    </form>
  </div>
</section>

<style>
  .contacts-left {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .contacts-lead {
    color: var(--muted);
    font-weight: 300;
    line-height: 1.55;
    margin: 0;
  }

  .contacts-direct {
    display: grid;
    gap: 10px;
  }
  .contacts-direct-item {
    display: flex;
    gap: 14px;
    align-items: center;
    padding: 14px 16px;
    background: var(--card);
    border: 1px solid var(--stroke);
    color: var(--text);
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
    transition: border-color 0.35s ease, background 0.35s ease, box-shadow 0.35s ease;
  }
  .contacts-direct-item:hover {
    border-color: rgba(74, 239, 121, 0.4);
    background: rgba(74, 239, 121, 0.04);
    box-shadow: none;
  }
  .contacts-direct-item :global(.contacts-direct-icon) {
    color: var(--accent);
    flex-shrink: 0;
  }
  .contacts-direct-label {
    font-size: 0.72rem;
    color: var(--muted);
    font-weight: 300;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin-bottom: 2px;
  }
  .contacts-direct-value {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text);
  }

  .contacts-reassure {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 8px;
  }
  .contacts-reassure li {
    display: flex;
    align-items: flex-start;
    gap: 10px;
    font-size: 0.92rem;
    line-height: 1.45;
    color: var(--muted);
    font-weight: 300;
  }
  .contacts-reassure :global(.contacts-check) {
    color: var(--accent);
    flex-shrink: 0;
    margin-top: 2px;
  }

  .contacts-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    padding-top: 8px;
    border-top: 1px solid var(--stroke);
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 300;
  }
  .contacts-meta-item {
    display: inline-flex;
    align-items: center;
    gap: 6px;
  }
  .contacts-meta-item :global(.contacts-meta-icon) {
    color: var(--accent);
  }

  .cf-honeypot {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .cf-optional {
    font-weight: 400;
    color: var(--muted);
    font-size: 0.85rem;
    margin-left: 4px;
  }

  .cf-consent {
    display: flex !important;
    flex-direction: row !important;
    align-items: flex-start;
    gap: 10px;
    font-weight: 400;
    font-size: 0.85rem;
    color: var(--muted);
    line-height: 1.45;
  }
  .cf-consent input[type="checkbox"] {
    width: 16px;
    height: 16px;
    margin-top: 3px;
    flex-shrink: 0;
    accent-color: var(--accent);
    cursor: pointer;
  }
  .cf-consent a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .cf-consent a:hover {
    text-decoration: none;
  }

  .form-status {
    margin: 0;
    font-size: 0.92rem;
    line-height: 1.45;
    font-weight: 400;
    min-height: 1em;
  }
  .form-status:empty {
    display: none;
  }
  .form-status.is-ok {
    color: var(--accent);
  }
  .form-status.is-err {
    color: #ff7070;
  }
  .form-status.is-wait {
    color: var(--muted);
  }

  .contact-form input:invalid:not(:placeholder-shown),
  .contact-form textarea:invalid:not(:placeholder-shown) {
    border-color: rgba(255, 112, 112, 0.6);
  }

  #cf-submit[disabled] {
    opacity: 0.7;
    cursor: progress;
  }
</style>

<script is:inline>
  (function () {
    const form = document.getElementById('contact-form');
    if (!form) return;
    const btn = document.getElementById('cf-submit');
    const status = document.getElementById('cf-status');
    const name = document.getElementById('cf-name');
    const phone = document.getElementById('cf-phone');
    const email = document.getElementById('cf-email');
    const comment = document.getElementById('cf-comment');
    const consent = document.getElementById('cf-consent');
    const honeypot = form.querySelector('input[name="website"]');

    const origBtn = btn.textContent;

    function setStatus(kind, msg) {
      status.className = 'form-status' + (kind ? ' is-' + kind : '');
      status.textContent = msg || '';
    }

    function digits(s) { return (s || '').replace(/\D+/g, ''); }

    form.addEventListener('submit', async function (ev) {
      ev.preventDefault();
      if (honeypot && honeypot.value) {
        setStatus('ok', 'Спасибо! Мы свяжемся с вами в рабочее время.');
        form.reset();
        return;
      }

      const n = (name.value || '').trim();
      const p = (phone.value || '').trim();
      const e = (email.value || '').trim();
      const c = (comment.value || '').trim();

      if (!n) { setStatus('err', 'Укажите ваше имя.'); name.focus(); return; }
      if (digits(p).length < 10) { setStatus('err', 'Проверьте номер телефона - минимум 10 цифр.'); phone.focus(); return; }
      if (e && !/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(e)) { setStatus('err', 'Проверьте email.'); email.focus(); return; }
      if (!consent.checked) { setStatus('err', 'Нужно согласие на обработку персональных данных.'); consent.focus(); return; }

      btn.disabled = true;
      btn.textContent = 'Отправляем…';
      setStatus('wait', 'Отправляем заявку…');

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name: n, phone: p, email: e, comment: c, consent: consent.checked, website: honeypot ? honeypot.value : '' })
        });
        let data = {};
        try { data = await res.json(); } catch (_) {}
        if (res.ok && data && data.ok) {
          setStatus('ok', 'Спасибо! Заявка принята - ответим в рабочее время.');
          form.reset();
        } else if (res.status === 429) {
          setStatus('err', 'Слишком много заявок с вашего IP. Попробуйте через минуту.');
        } else if (res.status === 400) {
          setStatus('err', 'Проверьте, что имя и телефон заполнены корректно.');
        } else {
          setStatus('err', 'Не удалось отправить. Напишите в Telegram или на почту - мы рядом.');
        }
      } catch (_) {
        setStatus('err', 'Нет связи с сервером. Напишите в Telegram или на почту.');
      } finally {
        btn.disabled = false;
        btn.textContent = origBtn;
      }
    });
  })();
</script>
