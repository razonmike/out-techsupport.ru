---
---

<section class="section calc-section" id="calculator">
  <div class="container">
    <h2>Рассчитайте стоимость обслуживания</h2>
    <p class="section-intro">Укажите параметры - получите ориентировочную стоимость за несколько секунд</p>

    <div class="calc-body reveal">
      <div class="calc-left">
        <div class="calc-tariffs" role="tablist" aria-label="Тариф">
          <button type="button" class="calc-tariff" data-tariff="remote" data-seat-price="600">
            <span class="calc-tariff-name">Удалённый</span>
            <span class="calc-tariff-price">600 ₽ / место</span>
          </button>
          <button type="button" class="calc-tariff is-active" data-tariff="optimal" data-seat-price="800">
            <span class="calc-tariff-name">Оптимальный</span>
            <span class="calc-tariff-price">800 ₽ / место</span>
          </button>
          <button type="button" class="calc-tariff" data-tariff="extended" data-seat-price="1000">
            <span class="calc-tariff-name">Расширенный</span>
            <span class="calc-tariff-price">1 000 ₽ / место</span>
          </button>
        </div>

        <div class="calc-row">
          <div class="calc-row-info">
            <div class="calc-row-title">Рабочие места</div>
            <div class="calc-row-price" id="seats-price">800 ₽ / место</div>
          </div>
          <div class="calc-counter">
            <button class="calc-btn-minus" data-target="seats" aria-label="Уменьшить количество рабочих мест">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <span class="calc-counter-value" id="seats">10</span>
            <button class="calc-btn-plus" data-target="seats" aria-label="Увеличить количество рабочих мест">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <div class="calc-row">
          <div class="calc-row-info">
            <div class="calc-row-title">Серверы физические</div>
            <div class="calc-row-price">2 000 ₽ / сервер</div>
          </div>
          <div class="calc-counter">
            <button class="calc-btn-minus" data-target="phys-servers" aria-label="Уменьшить количество физических серверов">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <span class="calc-counter-value" id="phys-servers">1</span>
            <button class="calc-btn-plus" data-target="phys-servers" aria-label="Увеличить количество физических серверов">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <div class="calc-row">
          <div class="calc-row-info">
            <div class="calc-row-title">Серверы виртуальные</div>
            <div class="calc-row-price">1 500 ₽ / сервер</div>
          </div>
          <div class="calc-counter">
            <button class="calc-btn-minus" data-target="virt-servers" aria-label="Уменьшить количество виртуальных серверов">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <span class="calc-counter-value" id="virt-servers">2</span>
            <button class="calc-btn-plus" data-target="virt-servers" aria-label="Увеличить количество виртуальных серверов">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <div class="calc-row">
          <div class="calc-row-info">
            <div class="calc-row-title">Сетевое оборудование</div>
            <div class="calc-row-price">500 ₽ / устройство</div>
          </div>
          <div class="calc-counter">
            <button class="calc-btn-minus" data-target="network" aria-label="Уменьшить количество сетевого оборудования">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <span class="calc-counter-value" id="network">2</span>
            <button class="calc-btn-plus" data-target="network" aria-label="Увеличить количество сетевого оборудования">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <div class="calc-row">
          <div class="calc-row-info">
            <div class="calc-row-title">Wi-Fi точки доступа</div>
            <div class="calc-row-price">500 ₽ / точка</div>
          </div>
          <div class="calc-counter">
            <button class="calc-btn-minus" data-target="wifi" aria-label="Уменьшить количество Wi-Fi точек">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <span class="calc-counter-value" id="wifi">2</span>
            <button class="calc-btn-plus" data-target="wifi" aria-label="Увеличить количество Wi-Fi точек">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>

        <div class="calc-row">
          <div class="calc-row-info">
            <div class="calc-row-title">МФУ / принтеры</div>
            <div class="calc-row-price">300 ₽ / устройство</div>
          </div>
          <div class="calc-counter">
            <button class="calc-btn-minus" data-target="mfp" aria-label="Уменьшить количество МФУ">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="15 18 9 12 15 6"/></svg>
            </button>
            <span class="calc-counter-value" id="mfp">1</span>
            <button class="calc-btn-plus" data-target="mfp" aria-label="Увеличить количество МФУ">
              <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="9 18 15 12 9 6"/></svg>
            </button>
          </div>
        </div>
      </div>

      <div class="calc-right">
        <div class="calc-result">
          <div class="calc-result-label">Итого:</div>
          <div class="calc-result-value" id="calc-price">20 000</div>
          <div class="calc-result-period">₽ / месяц</div>
          <a class="btn" href="#contacts">Заказать услуги</a>
          <div class="calc-result-note">Стоимость указана без НДС. Минимум 1 месяц.</div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  type CalcItem = { id: string; price: number; min: number };

  const items: CalcItem[] = [
    { id: 'seats', price: 800, min: 1 },
    { id: 'phys-servers', price: 2000, min: 0 },
    { id: 'virt-servers', price: 1500, min: 0 },
    { id: 'network', price: 500, min: 0 },
    { id: 'wifi', price: 500, min: 0 },
    { id: 'mfp', price: 300, min: 0 },
  ];

  const priceEl = document.getElementById('calc-price');
  const seatsPriceEl = document.getElementById('seats-price');

  function getVal(id: string): number {
    const el = document.getElementById(id);
    return el ? parseInt(el.textContent || '0', 10) : 0;
  }

  function setVal(id: string, val: number) {
    const el = document.getElementById(id);
    if (el) el.textContent = String(val);
  }

  function formatRub(n: number): string {
    return n.toLocaleString('ru-RU');
  }

  function updateTotal() {
    let total = 0;
    for (const item of items) {
      total += getVal(item.id) * item.price;
    }
    if (priceEl) priceEl.textContent = formatRub(total);
  }

  document.querySelectorAll<HTMLButtonElement>('.calc-btn-minus').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.target;
      if (!target) return;
      const item = items.find((i) => i.id === target);
      const current = getVal(target);
      if (item && current > item.min) {
        setVal(target, current - 1);
        updateTotal();
      }
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.calc-btn-plus').forEach((btn) => {
    btn.addEventListener('click', () => {
      const target = btn.dataset.target;
      if (!target) return;
      const current = getVal(target);
      setVal(target, current + 1);
      updateTotal();
    });
  });

  document.querySelectorAll<HTMLButtonElement>('.calc-tariff').forEach((btn) => {
    btn.addEventListener('click', () => {
      const seatPrice = parseInt(btn.dataset.seatPrice || '800', 10);
      const seatsItem = items.find((i) => i.id === 'seats');
      if (seatsItem) seatsItem.price = seatPrice;
      if (seatsPriceEl) seatsPriceEl.textContent = formatRub(seatPrice) + ' ₽ / место';
      document.querySelectorAll('.calc-tariff').forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      updateTotal();
    });
  });

  updateTotal();
</script>

<style>
  .calc-tariffs {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 8px;
    padding: 16px 20px 4px;
  }
  .calc-tariff {
    background: transparent;
    border: 1px solid var(--stroke);
    border-radius: 2px;
    padding: 12px 10px;
    display: flex;
    flex-direction: column;
    gap: 4px;
    cursor: pointer;
    color: var(--muted);
    font-family: inherit;
    box-shadow: 0 14px 30px rgba(0, 0, 0, 0.35);
    transition: border-color 0.35s ease, color 0.35s ease, background 0.35s ease, box-shadow 0.35s ease;
    clip-path: polygon(6px 0, 100% 0, 100% 100%, 0 100%, 0 6px);
  }
  .calc-tariff:hover {
    border-color: rgba(74, 239, 121, 0.4);
    color: var(--text);
    box-shadow: none;
  }
  .calc-tariff.is-active {
    border-color: var(--accent);
    background: rgba(74, 239, 121, 0.06);
    color: var(--text);
  }
  .calc-tariff-name {
    font-weight: 700;
    font-size: 0.92rem;
    letter-spacing: 0;
  }
  .calc-tariff-price {
    font-size: 0.78rem;
    font-weight: 400;
    color: var(--muted);
    font-family: "Space Mono", monospace;
  }
  .calc-tariff.is-active .calc-tariff-price {
    color: var(--accent);
  }

  @media (max-width: 720px) {
    .calc-tariffs {
      grid-template-columns: 1fr;
    }
  }
</style>
