---
import ArrowRight from 'phosphor-astro/ArrowRight.astro';

const services = [
  {
    href: '/services/it-outsourcing/',
    title: 'IT-аутсорсинг',
    desc: 'Снижаем нагрузку на команду: обслуживаем рабочие места, серверы и сеть в режиме одного окна.',
  },
  {
    href: '/services/wifi/',
    title: 'Организация Wi-Fi',
    desc: 'Проектируем стабильный корпоративный Wi-Fi без «мёртвых зон» и обрывов связи.',
  },
  {
    href: '/services/video-surveillance/',
    title: 'Видеонаблюдение и СКУД',
    desc: 'Монтаж и обслуживание IP-камер и систем контроля доступа. Удалённый просмотр, запись инцидентов.',
  },
  {
    href: '/services/1c/',
    title: 'Поддержка 1С',
    desc: 'Обеспечиваем бесперебойную работу 1С: от развёртывания до оптимизации и бэкапов.',
  },
  {
    href: '/services/virtualization/',
    title: 'Виртуализация',
    desc: 'Несколько серверов на одном физическом. Снижаем расходы на инфраструктуру до 50% за счёт замены облака на собственные серверы.',
  },
  {
    href: '/services/system-administration/',
    title: 'Системное администрирование',
    desc: 'Сопровождаем серверы, сеть и рабочие места. Мониторинг и профилактика до сбоя - меньше простоев и вызовов в экстренном режиме.',
  },
  {
    href: '/services/devops/',
    title: 'DevOps',
    desc: 'Автоматизируем выпуск обновлений и работу ваших сервисов: меньше ручных операций, стабильные релизы, проблемы видны до сбоя.',
  },
  {
    href: '/services/software-development/',
    title: 'Разработка ПО',
    desc: 'Интеграции между системами, Telegram-боты и веб-приложения. Автоматизируем рутину, которая сейчас делается руками.',
  },
  {
    href: '/services/ai/',
    title: 'Внедрение AI',
    desc: 'AI-ассистенты, обработка документов и заявок, обучение сотрудников. Начинаем с задач, которые окупаются быстро.',
  },
];
---

<section id="services" class="section section-with-bg">
  <div class="container">
    <h2>Наши ключевые услуги</h2>
    <p class="section-intro reveal">
      Закрываем как ежедневную поддержку, так и сложные инфраструктурные задачи
      без найма большого внутреннего IT-штата.
    </p>
    <div class="cards cards-3">
      {services.map((s) => (
        <a class="card service-card reveal" href={s.href}>
          <h3>{s.title}</h3>
          <p>{s.desc}</p>
          <span class="service-card-link">Подробнее <ArrowRight width={14} height={14} /></span>
        </a>
      ))}
    </div>
  </div>
</section>

<style>
  .service-card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: inherit;
    text-decoration: none;
    cursor: pointer;
  }
  .service-card-link {
    margin-top: auto;
    padding-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: 0.82rem;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.02em;
  }
  .service-card:hover .service-card-link {
    gap: 10px;
  }
</style>
