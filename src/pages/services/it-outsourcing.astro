---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import Included from '../../components/service/Included.astro';
import ForWhom from '../../components/service/ForWhom.astro';
import Process from '../../components/service/Process.astro';
import FAQ from '../../components/service/FAQ.astro';
import FinalCTA from '../../components/service/FinalCTA.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';
import Contacts from '../../components/Contacts.astro';

import Headphones from 'phosphor-astro/Headphones.astro';
import Clock from 'phosphor-astro/Clock.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';
import ChartLine from 'phosphor-astro/ChartLine.astro';
import UserGear from 'phosphor-astro/UserGear.astro';
import Desktop from 'phosphor-astro/Desktop.astro';
import Network from 'phosphor-astro/Network.astro';
import Database from 'phosphor-astro/Database.astro';
import WifiHigh from 'phosphor-astro/WifiHigh.astro';
import HardDrives from 'phosphor-astro/HardDrives.astro';
import ShieldWarning from 'phosphor-astro/ShieldWarning.astro';

const title = 'IT-аутсорсинг для бизнеса | TechSupport Казань';
const description = 'Абонентское IT-обслуживание: поддержка пользователей, серверов, сетей, 1С и VPN. Удалённо и с выездом по Казани и региону. С 2014 года.';
---

<Layout title={title} description={description}>
  <ServiceHero
    title="IT-аутсорсинг"
    lead="Внешний IT-отдел для вашего бизнеса. Берём на себя обслуживание IT-инфраструктуры: рабочие места, серверы, сети, 1С, VPN и резервное копирование. Единая зона ответственности, предсказуемая ежемесячная стоимость, без больничных и отпусков."
    features={[
      { icon: Clock, label: 'Реакция от 15 минут', desc: 'В рабочее время - быстрый ответ и разбор инцидента.' },
      { icon: Headphones, label: 'Одно окно поддержки', desc: 'Все IT-вопросы через единый канал связи.' },
      { icon: ShieldCheck, label: 'SLA и отчётность', desc: 'Фиксированные обязательства и месячные отчёты о работах.' },
      { icon: ChartLine, label: 'Развитие, а не «тушение»', desc: 'Предотвращаем сбои, а не только реагируем на аварии.' },
    ]}
  />

  <Included
    heading="Что входит в абонентское обслуживание"
    intro="Закрываем IT-задачи в полном цикле - от ежедневной поддержки пользователей до планового развития инфраструктуры."
    items={[
      { icon: Desktop, title: 'Поддержка рабочих мест', desc: 'Установка ПО, настройка почты, принтеров, решение ежедневных проблем пользователей.' },
      { icon: UserGear, title: 'Администрирование серверов', desc: 'Windows Server, Linux, обновления, безопасность, доменные учётки, права доступа.' },
      { icon: Network, title: 'Сеть и Wi-Fi', desc: 'Маршрутизаторы, коммутаторы, точки доступа, VLAN, VPN между офисами и удалёнщиками.' },
      { icon: Database, title: 'Инфраструктура 1С', desc: 'Сервер 1С, SQL, терминальный доступ, обновления конфигураций, бэкапы баз.' },
      { icon: HardDrives, title: 'Резервное копирование', desc: 'Настройка регулярных бэкапов, отчуждаемое хранилище, регулярные проверки восстановления.' },
      { icon: ShieldWarning, title: 'Безопасность и мониторинг', desc: 'Антивирус, политики доступа, мониторинг серверов и сетевого оборудования 24/7.' },
    ]}
  />

  <ForWhom
    heading="Кому подходит"
    intro="Абонентское обслуживание - для компаний, которым нужна стабильная IT-среда без разовых авралов."
    scenarios={[
      {
        title: 'Малому и среднему бизнесу без своего IT-специалиста',
        desc: 'Все IT-задачи переходят на внешнюю команду. Вы получаете не одного человека, а команду инженеров с разной специализацией.',
      },
      {
        title: 'Компаниям, у которых есть системный администратор',
        desc: 'Закрываем направления, которые один человек физически не тянет: серверы, сеть, безопасность, 1С. Берём на себя дежурство и выходные.',
      },
      {
        title: 'Компаниям с филиалами и удалёнными сотрудниками',
        desc: 'Объединяем офисы через VPN, обеспечиваем единую политику безопасности и доступов, поддерживаем удалённых пользователей.',
      },
      {
        title: 'Тем, кто устал от разовых подрядчиков',
        desc: 'Один ответственный за всю IT-инфраструктуру. Нет ситуации «это не наш участок работ».',
      },
    ]}
  />

  <Process
    heading="Как мы запускаем работу"
    intro="От первого контакта до штатного сопровождения - обычно 1-2 недели."
    steps={[
      { title: 'Аудит', desc: 'Проводим бесплатный аудит: инвентаризуем оборудование, находим узкие места и риски, фиксируем текущее состояние.' },
      { title: 'Предложение', desc: 'Формируем план работ на первый месяц и коммерческое предложение с понятной стоимостью без скрытых платежей.' },
      { title: 'Подключение', desc: 'Разворачиваем систему мониторинга, подключаем учётные записи, фиксируем SLA и процессы коммуникации.' },
      { title: 'Сопровождение', desc: 'Ведём задачи в тикет-системе, ежемесячно отчитываемся о выполненных работах и предлагаем улучшения.' },
    ]}
  />

  <FAQ
    items={[
      {
        q: 'Как формируется стоимость обслуживания?',
        a: 'Стоимость зависит от количества рабочих мест, серверов и сетевого оборудования. Цена фиксируется в договоре и не меняется от месяца к месяцу - никаких «вы превысили лимит обращений».',
      },
      {
        q: 'Что если у нас уже есть системный администратор?',
        a: 'Работаем в паре: ваш специалист ведёт ежедневные задачи пользователей, мы закрываем серверы, сеть, безопасность, 1С и замену на время отпусков и больничных. Это дешевле найма второго сотрудника.',
      },
      {
        q: 'Как быстро реагируете на инциденты?',
        a: 'В рабочее время (9:00-19:00 будние дни) - от 15 минут. На тарифах с расширенным SLA - круглосуточно. На критичные инциденты (падение серверов, сетевые аварии) - реакция приоритетная.',
      },
      {
        q: 'Работаете только удалённо?',
        a: 'Нет. Удалённо закрываем большинство задач, но выезжаем на объекты для физических работ: монтажа оборудования, диагностики сети, замены железа. По Казани и Татарстану выезд обычно в день обращения.',
      },
      {
        q: 'Заключаете договор и работаете по безналу?',
        a: 'Да. Юридическое лицо, договор с НДС или без (УСН), закрывающие документы. Работаем с оплатой помесячно по факту.',
      },
      {
        q: 'Можно попробовать без обязательств на год?',
        a: 'Можно. Минимальный срок договора - 1 месяц, расторгается по заявлению за 30 дней. Первый месяц со скидкой 20%.',
      },
    ]}
  />

  <FinalCTA
    heading="Передайте IT на аутсорс - сосредоточьтесь на бизнесе"
    text="Проведём бесплатный аудит текущей инфраструктуры, покажем узкие места и предложим формат работы. Без обязательств."
    primary={{ label: 'Получить бесплатный аудит', href: '#contacts' }}
    secondary={{ label: 'Посмотреть тарифы', href: '/#prices' }}
  />

  <Contacts />

  <RelatedServices currentSlug="it-outsourcing" />
</Layout>
