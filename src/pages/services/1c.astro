---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import Included from '../../components/service/Included.astro';
import ForWhom from '../../components/service/ForWhom.astro';
import Process from '../../components/service/Process.astro';
import FAQ from '../../components/service/FAQ.astro';
import FinalCTA from '../../components/service/FinalCTA.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';
import Breadcrumbs from '../../components/service/Breadcrumbs.astro';
import Contacts from '../../components/Contacts.astro';

import Database from 'phosphor-astro/Database.astro';
import Desktop from 'phosphor-astro/Desktop.astro';
import HardDrives from 'phosphor-astro/HardDrives.astro';
import Lightning from 'phosphor-astro/Lightning.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';
import UserGear from 'phosphor-astro/UserGear.astro';
import Clock from 'phosphor-astro/Clock.astro';

const title = 'Поддержка и обслуживание 1С в Казани | TechSupport';
const description = 'Инфраструктурная поддержка 1С в Казани и Татарстане: сервер, MS SQL/PostgreSQL, терминальный доступ, резервное копирование, обновления платформы. Работаем с Бухгалтерией, УТ, ЗУП, ERP. С 2014 года.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Поддержка и обслуживание 1С',
  provider: { '@type': 'LocalBusiness', name: 'TechSupport', url: 'https://out-techsupport.ru' },
  areaServed: [
    { '@type': 'City', name: 'Казань' },
    { '@type': 'State', name: 'Республика Татарстан' },
  ],
};
---

<Layout title={title} description={description} schema={serviceSchema}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Услуги', href: '/#services' }, { label: 'Поддержка 1С' }]} />
  </div>
  <ServiceHero
    title="Поддержка 1С"
    lead="1С без тормозов, без потери данных и без остановки бухгалтерии. Отвечаем за инфраструктуру 1С: сервер, SQL, резервное копирование, удалённый доступ, обновления платформы. Не программируем конфигурации - занимаемся тем, без чего 1С просто не работает. Работаем с Бухгалтерией, УТ, ЗУП, ERP."
    features={[
      { icon: Lightning, label: 'Быстрая 1С', desc: 'Оптимизация базы, SQL, терминального сервера - тормозящая база ускоряется в разы.' },
      { icon: HardDrives, label: 'Бэкапы каждый день', desc: 'Автоматическое резервирование, проверка восстановления, отчуждаемое хранилище.' },
      { icon: UserGear, label: 'Удалённый доступ', desc: 'Терминальный сервер или веб-клиент 1С для работы из дома и филиалов.' },
      { icon: Clock, label: 'Обновления без простоя', desc: 'Плановые обновления платформы и релизов в нерабочее время.' },
    ]}
  />

  <Included
    heading="Что входит"
    intro="Берём на себя всё, что связано с инфраструктурой 1С, - от развёртывания до ежедневного сопровождения."
    items={[
      { icon: Database, title: 'Развёртывание серверов 1С', desc: 'Сервер приложений + MS SQL или PostgreSQL, настройка под количество пользователей.' },
      { icon: Desktop, title: 'Терминальный доступ', desc: 'RDP или веб-клиент 1С, безопасное подключение из дома и филиалов.' },
      { icon: HardDrives, title: 'Резервное копирование', desc: 'Ежедневные бэкапы баз, отчуждаемое хранилище, регулярные проверки восстановления.' },
      { icon: Lightning, title: 'Оптимизация производительности', desc: 'Диагностика медленных операций, настройка индексов SQL, регламентные задачи.' },
      { icon: ShieldCheck, title: 'Безопасность и доступы', desc: 'Разграничение прав по ролям, политики паролей, журнал действий, защита от шифровальщиков.' },
      { icon: UserGear, title: 'Обновления платформы', desc: 'Обновление 1С:Предприятия до актуальной версии, миграция с файлового на серверный режим.' },
    ]}
  />

  <ForWhom
    heading="Кому подходит"
    intro="Работаем с компаниями на любой стадии - от «база на рабочем ПК бухгалтера» до «серверный кластер с ERP»."
    scenarios={[
      { title: 'Компаниям, у которых 1С тормозит', desc: 'Отчёты формируются по 20 минут, проводки зависают, документы открываются с ожиданием. Диагностируем и устраняем.' },
      { title: 'Тем, кто хранит базу на одном компьютере', desc: 'Файловая база на сервере или локальном ПК - риск потерять всё при поломке. Переносим на серверный режим с бэкапами.' },
      { title: 'Компаниям с удалёнщиками и филиалами', desc: 'Бухгалтер из дома, менеджеры из филиалов - настраиваем защищённый доступ без тормозов и с разграничением прав.' },
      { title: 'Тем, кто меняет конфигурацию', desc: 'Миграция с 7.7 на 8, переход с УТ на ERP, внедрение ЗУП - берём на себя инфраструктурную часть.' },
    ]}
  />

  <Process
    intro="Первый результат обычно на 1-5 рабочий день после согласования."
    steps={[
      { title: 'Аудит', desc: 'Анализируем текущую инсталляцию: версия платформы, способ хранения, нагрузка, точки отказа.' },
      { title: 'План работ', desc: 'План миграции или модернизации с оценкой простоя, бюджетом и сроками.' },
      { title: 'Реализация', desc: 'Развёртывание, перенос данных, тестирование, переключение пользователей - обычно в нерабочие часы.' },
      { title: 'Сопровождение', desc: 'Мониторинг серверов, бэкапы, обновления, оперативная поддержка бухгалтерии.' },
    ]}
  />

  <FAQ
    items={[
      { q: 'Вы 1С-франчайзи? Дорабатываете конфигурации?', a: 'Нет. Мы не программисты 1С и не дорабатываем конфигурации. Занимаемся инфраструктурой: сервером, SQL, бэкапами, терминальным доступом, обновлениями платформы. Если нужна доработка конфигурации - подскажем проверенных партнёров.' },
      { q: 'Поможете перенести базу с файлового режима на сервер?', a: 'Да. Разворачиваем сервер 1С + SQL/PostgreSQL, переносим базы, настраиваем регламентные задания и бэкапы. Время миграции - от одного рабочего дня на базу.' },
      { q: 'С чем работаете: MS SQL или PostgreSQL?', a: 'С обоими. MS SQL Server - более распространённый и привычный администраторам 1С. PostgreSQL - бесплатный, работает под Linux, даёт экономию на лицензиях. Подбираем под задачу и бюджет.' },
      { q: 'Как часто делаются бэкапы?', a: 'Стандартно: полный бэкап ежедневно ночью, инкрементальные - каждые 2-4 часа в рабочее время. Копии хранятся локально и на отчуждаемом носителе. По запросу - в облако.' },
      { q: 'Как настраиваете удалённый доступ?', a: 'Через терминальный сервер (RDP) или веб-клиент 1С. Доступ - строго через VPN или защищённый шлюз, без открытого проброса портов в интернет. С двухфакторной авторизацией на критичных ролях.' },
      { q: 'Что будет при падении сервера 1С в рабочее время?', a: 'На абонентском обслуживании - реакция от 15 минут, восстановление обычно 1-2 часа (если есть свежий бэкап). Для критичных баз настраиваем отказоустойчивые кластеры - переключение на резервный сервер за минуты.' },
    ]}
  />

  <FinalCTA
    heading="Сделайте 1С быстрой и надёжной"
    text="Проверим текущую инсталляцию, найдём узкие места и покажем что можно улучшить. Аудит 1С - бесплатно."
    primary={{ label: 'Заказать аудит 1С', href: '#contacts' }}
    secondary={{ label: 'Посмотреть тарифы', href: '/#prices' }}
  />

  <Contacts />

  <RelatedServices currentSlug="1c" />
</Layout>
