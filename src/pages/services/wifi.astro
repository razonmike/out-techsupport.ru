---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import Included from '../../components/service/Included.astro';
import ForWhom from '../../components/service/ForWhom.astro';
import Process from '../../components/service/Process.astro';
import FAQ from '../../components/service/FAQ.astro';
import FinalCTA from '../../components/service/FinalCTA.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';
import Breadcrumbs from '../../components/service/Breadcrumbs.astro';
import Contacts from '../../components/Contacts.astro';

import WifiHigh from 'phosphor-astro/WifiHigh.astro';
import Network from 'phosphor-astro/Network.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';
import Lightning from 'phosphor-astro/Lightning.astro';
import Desktop from 'phosphor-astro/Desktop.astro';
import UserGear from 'phosphor-astro/UserGear.astro';
import Clock from 'phosphor-astro/Clock.astro';

const title = 'Настройка Wi-Fi в офисе и на складе в Казани | TechSupport';
const description = 'Проектирование и монтаж корпоративного Wi-Fi на MikroTik в Казани и Татарстане. Покрытие без мёртвых зон, гостевой доступ, разделение сетей, безопасность.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Организация корпоративного Wi-Fi',
  provider: { '@type': 'LocalBusiness', name: 'TechSupport', url: 'https://out-techsupport.ru' },
  areaServed: [
    { '@type': 'City', name: 'Казань' },
    { '@type': 'State', name: 'Республика Татарстан' },
  ],
};
---

<Layout title={title} description={description} schema={serviceSchema}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Услуги', href: '/#services' }, { label: 'Организация Wi-Fi' }]} />
  </div>
  <ServiceHero
    title="Организация Wi-Fi"
    lead="Корпоративный Wi-Fi без обрывов и мёртвых зон - для офиса, склада и HoReCa. Проектируем по замерам на объекте, разделяем гостевой и рабочий контуры. Строим сети на оборудовании MikroTik - это наша основная платформа: гибкая настройка, надёжность и без переплат за бренд."
    features={[
      { icon: WifiHigh, label: 'Сплошное покрытие', desc: 'Замеры сигнала на этапе проекта, подбор количества и расположения точек.' },
      { icon: Network, label: 'Единый контроллер', desc: 'Бесшовный роуминг между точками, быстрый переход устройств без обрыва связи.' },
      { icon: ShieldCheck, label: 'Гость и работа раздельно', desc: 'Отдельные VLAN и SSID, изоляция гостей от корпоративной сети.' },
      { icon: Lightning, label: 'Нагрузка 50+ устройств', desc: 'Масштабируемое оборудование, рассчитанное на плотность клиентов.' },
    ]}
  />

  <Included
    heading="Что входит в проект"
    intro="Закрываем весь цикл работ - от обследования объекта до сопровождения готовой сети."
    items={[
      { icon: WifiHigh, title: 'Аудит покрытия', desc: 'Замеряем сигнал в текущей сети, находим мёртвые зоны, определяем источники помех.' },
      { icon: Desktop, title: 'Проект и подбор оборудования', desc: 'Схема расположения точек, расчёт кабельной инфраструктуры, 2-3 варианта по бюджету.' },
      { icon: UserGear, title: 'Монтаж и настройка', desc: 'Прокладка СКС, установка точек, конфигурация контроллера, VLAN и SSID.' },
      { icon: ShieldCheck, title: 'Безопасность и доступ', desc: 'WPA2/WPA3 Enterprise, RADIUS-авторизация, гостевой портал с лимитами по трафику и времени.' },
      { icon: Network, title: 'VPN и интеграция филиалов', desc: 'Связка Wi-Fi с корпоративным VPN, единая политика доступа в нескольких офисах.' },
      { icon: Clock, title: 'Сопровождение и мониторинг', desc: 'Наблюдение за состоянием точек 24/7, регулярные обновления прошивок.' },
    ]}
  />

  <ForWhom
    heading="Кому подходит"
    intro="Проектируем Wi-Fi под конкретные задачи бизнеса - офиса, склада, розницы или филиальной сети."
    scenarios={[
      { title: 'Офисам, в которых растёт штат', desc: 'Добавление сотрудников - текущий Wi-Fi уже не справляется. Расширяем существующую сеть или проектируем новую под рост.' },
      { title: 'Складам и производствам', desc: 'Большая площадь, металлические конструкции, подвижные сотрудники со сканерами. Нужна архитектура с бесшовным роумингом.' },
      { title: 'HoReCa, клиникам, рознице', desc: 'Посетители требуют быстрый интернет, но отдельно от рабочей сети. Гостевой SSID с лимитом по трафику и времени.' },
      { title: 'Филиальным компаниям', desc: 'Единая политика Wi-Fi во всех офисах, централизованная диагностика и управление из одной точки.' },
    ]}
  />

  <Process
    intro="От первого выезда до запуска - обычно 3-7 рабочих дней на типовой офис."
    steps={[
      { title: 'Аудит', desc: 'Выезжаем на объект, замеряем сигнал, определяем топологию, собираем требования бизнеса.' },
      { title: 'Проект', desc: 'Схема размещения точек, 2-3 варианта оборудования с разным бюджетом, согласование.' },
      { title: 'Монтаж', desc: 'Прокладка СКС, установка точек, настройка контроллера, VLAN, гостевого доступа.' },
      { title: 'Поддержка', desc: 'Запуск мониторинга, обучение ответственного, плановые обновления и доработки.' },
    ]}
  />

  <FAQ
    items={[
      { q: 'Сколько нужно точек доступа на офис 300 м²?', a: 'Зависит от планировки, количества сотрудников и помех. В среднем - 2-4 точки на открытый офис 300 м² с 30-50 пользователями. Точное число определяем после аудита на месте.' },
      { q: 'Подойдёт ли обычный роутер из магазина?', a: 'Для 5-10 устройств в небольшом офисе - да. Для 20+ устройств, нескольких помещений или сложной планировки - нет: будут обрывы, падение скорости и невозможность разделить гостей и работу. Нужны профессиональные точки доступа с поддержкой VLAN и контроллером.' },
      { q: 'С каким оборудованием работаете?', a: 'Основная платформа - MikroTik: оптимальное соотношение цены, гибкости и надёжности для бизнеса. От 50 000 ₽ за базовое офисное покрытие до решений с бесшовным роумингом и централизованным контроллером (CAPsMAN).' },
      { q: 'Сколько занимает проект?', a: 'Офис 200-500 м² - 3-7 рабочих дней от согласования до запуска. Большие объекты, склады, филиальные сети - от 2-4 недель с учётом поставки оборудования.' },
      { q: 'Можно объединить Wi-Fi нескольких офисов в одну сеть?', a: 'Да. Связываем офисы через VPN (IPsec или WireGuard), единая политика доступа, общие ресурсы (принтеры, сетевые папки, 1С) работают как в локальной сети.' },
      { q: 'Что с поддержкой после запуска?', a: 'Сеть подключается к мониторингу, падения точек и проблемы с провайдером видим сразу. На абонентском обслуживании сопровождение Wi-Fi включено в тариф.' },
    ]}
  />

  <FinalCTA
    heading="Получите стабильный Wi-Fi для бизнеса"
    text="Приедем, замеряем, покажем где проблемы и дадим 2-3 варианта решения. Аудит покрытия - бесплатно."
    primary={{ label: 'Заказать аудит Wi-Fi', href: '#contacts' }}
    secondary={{ label: 'Посмотреть тарифы', href: '/#prices' }}
  />

  <Contacts />

  <RelatedServices currentSlug="wifi" />
</Layout>
