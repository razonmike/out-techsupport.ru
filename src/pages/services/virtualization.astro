---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import Included from '../../components/service/Included.astro';
import ForWhom from '../../components/service/ForWhom.astro';
import Process from '../../components/service/Process.astro';
import FAQ from '../../components/service/FAQ.astro';
import FinalCTA from '../../components/service/FinalCTA.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';
import Breadcrumbs from '../../components/service/Breadcrumbs.astro';
import Contacts from '../../components/Contacts.astro';

import Cpu from 'phosphor-astro/Cpu.astro';
import HardDrives from 'phosphor-astro/HardDrives.astro';
import Network from 'phosphor-astro/Network.astro';
import TrendUp from 'phosphor-astro/TrendUp.astro';
import Database from 'phosphor-astro/Database.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';

const title = 'Виртуализация серверов в Казани: Proxmox, VMware, Hyper-V | TechSupport';
const description = 'Виртуализация и миграция серверов в Казани и Татарстане: Proxmox VE, VMware vSphere, Hyper-V. Отказоустойчивые кластеры, резервное копирование Proxmox Backup Server. Экономия на оборудовании до 50%.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Виртуализация серверов',
  provider: { '@type': 'LocalBusiness', name: 'TechSupport', url: 'https://out-techsupport.ru' },
  areaServed: [
    { '@type': 'City', name: 'Казань' },
    { '@type': 'State', name: 'Республика Татарстан' },
  ],
};
---

<Layout title={title} description={description} schema={serviceSchema}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Услуги', href: '/#services' }, { label: 'Виртуализация' }]} />
  </div>
  <ServiceHero
    title="Виртуализация"
    lead="Объединяем несколько физических серверов в один мощный хост - с запасом под рост и быстрым восстановлением после сбоев. Основная платформа - Proxmox: open source, без лицензий, ставится на любое оборудование. Делаем миграцию работающих серверов без переустановки, отказоустойчивые кластеры и резервное копирование. Если у вас уже VMware или Hyper-V - поддержим и при необходимости поможем перейти на Proxmox. Замена облака на собственные серверы сокращает расходы на инфраструктуру до 50%."
    features={[
      { icon: Cpu, label: 'Экономия на оборудовании', desc: '5 серверов → 1 хост с виртуальными машинами, сокращение затрат на электричество и обслуживание.' },
      { icon: HardDrives, label: 'Снимки и откат', desc: 'Мгновенные снимки перед обновлениями, откат за минуты.' },
      { icon: Network, label: 'Отказоустойчивые кластеры', desc: 'Автоматический перезапуск виртуальных машин на резервном хосте при отказе оборудования.' },
      { icon: TrendUp, label: 'Масштабирование без покупки', desc: 'Новый сервис - новая виртуальная машина, без заказа и ожидания поставки оборудования.' },
    ]}
  />

  <Included
    heading="Что входит"
    intro="Основная платформа - Proxmox: гибко, без лицензий и привязки к вендору. Если у вас уже стоит VMware или Hyper-V - поддерживаем их и при необходимости помогаем перейти на Proxmox."
    items={[
      { icon: Cpu, title: 'Выбор платформы', desc: 'Proxmox VE по умолчанию - open source, без лицензий, на любом оборудовании. VMware или Hyper-V - если для них есть веские причины.' },
      { icon: HardDrives, title: 'Миграция с физических серверов', desc: 'P2V-миграция рабочих серверов без простоя или с минимальным окном обслуживания.' },
      { icon: Network, title: 'Отказоустойчивые кластеры', desc: 'HA-кластеры на 2+ хоста, общее хранилище, автоматическое переключение виртуальных машин при сбоях.' },
      { icon: Database, title: 'Хранилища и СХД', desc: 'Настройка NAS/SAN, iSCSI, NFS, репликация между площадками.' },
      { icon: ShieldCheck, title: 'Резервное копирование', desc: 'Proxmox Backup Server - инкрементальные копии и репликация виртуальных машин.' },
      { icon: TrendUp, title: 'Мониторинг и планирование', desc: 'Отслеживание нагрузки по процессору, памяти и дискам, планирование расширения до того, как ресурсы закончатся.' },
    ]}
  />

  <ForWhom
    heading="Кому подходит"
    intro="Виртуализация окупается уже на 3-5 серверах - либо за счёт экономии на оборудовании, либо за счёт отказоустойчивости."
    scenarios={[
      { title: 'Компаниям с 3+ серверами', desc: 'Консолидация в 1-2 мощных хоста, экономия на электричестве и серверной, упрощение обслуживания.' },
      { title: 'Тем, кто обновляет оборудование', desc: 'Покупка нового сервера - повод мигрировать всё на виртуальные машины и получить отказоустойчивость заодно.' },
      { title: 'Компаниям с требованиями к аварийному восстановлению', desc: 'Репликация виртуальных машин между площадками - при отказе основной запускаются на резервной за минуты.' },
      { title: 'Разработке и тестированию', desc: 'Быстрое развёртывание тестовых стендов, клонирование рабочей среды в тестовую, сброс к чистому состоянию.' },
    ]}
  />

  <Process
    intro="От аудита до запуска продуктива - от 2 до 6 недель в зависимости от размера инфраструктуры."
    steps={[
      { title: 'Аудит инфраструктуры', desc: 'Инвентаризация серверов, нагрузок, требований к доступности и бюджета.' },
      { title: 'Выбор платформы и проект', desc: 'Проект на Proxmox (или VMware/Hyper-V, если нужно), расчёт оборудования и при необходимости лицензий.' },
      { title: 'Миграция', desc: 'Поэтапный перенос сервисов на виртуальную платформу, тестирование, переключение в окно обслуживания.' },
      { title: 'Сопровождение', desc: 'Мониторинг кластера, бэкапы, обновления хостов, планирование расширения.' },
    ]}
  />

  <FAQ
    items={[
      { q: 'Какую платформу выбрать?', a: 'В большинстве случаев рекомендуем Proxmox: open source, без лицензий, ставится на любое оборудование и закрывает задачи большинства компаний. VMware - промышленный стандарт, но дорог в лицензировании; Hyper-V имеет смысл, если уже есть Windows Server Datacenter. После аудита честно скажем, что выгоднее в вашем случае.' },
      { q: 'Можно мигрировать старые серверы без переустановки?', a: 'Да. P2V-миграция (с физического сервера на виртуальный) - переносим работающий Windows или Linux сервер в виртуальную машину. Обычно окно простоя 1-3 часа ночью или в выходные.' },
      { q: 'Что если хост-сервер выйдет из строя?', a: 'На одиночном хосте - восстановление из резервной копии, 1-4 часа в зависимости от размера. На HA-кластере - автоматическое переключение виртуальных машин на резервный хост, простой 1-3 минуты.' },
      { q: 'Сколько стоит виртуализация?', a: 'Proxmox - только стоимость оборудования и работ. Hyper-V - бесплатен отдельно или уже включён в Windows Server Datacenter. VMware vSphere - от 300 000 ₽ за Essentials Plus на 3 хоста. Работы по миграции - от 40 000 ₽.' },
      { q: 'Что с 1С на виртуальной машине?', a: '1С отлично работает в виртуальной машине при правильной настройке: выделенные ядра, гарантированный объём оперативной памяти, SSD-хранилище. Снижения производительности относительно физического сервера нет.' },
      { q: 'Как с лицензиями Windows на виртуальных машинах?', a: 'Windows Server Standard - 2 виртуальные машины на физическом хосте, Datacenter - неограниченно. Разбираемся с лицензионной моделью и подсказываем оптимальный вариант под ваши нагрузки.' },
    ]}
  />

  <FinalCTA
    heading="Переведите серверы на виртуализацию"
    text="Проанализируем текущую инфраструктуру, покажем, сколько можно сэкономить на оборудовании и как получить отказоустойчивость. Аудит - бесплатно."
    primary={{ label: 'Заказать аудит серверов', href: '#contacts' }}
    secondary={{ label: 'Посмотреть тарифы', href: '/#prices' }}
  />

  <Contacts />

  <RelatedServices currentSlug="virtualization" />
</Layout>
