---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import Included from '../../components/service/Included.astro';
import ForWhom from '../../components/service/ForWhom.astro';
import Process from '../../components/service/Process.astro';
import FAQ from '../../components/service/FAQ.astro';
import FinalCTA from '../../components/service/FinalCTA.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';
import Breadcrumbs from '../../components/service/Breadcrumbs.astro';
import Contacts from '../../components/Contacts.astro';

import Cpu from 'phosphor-astro/Cpu.astro';
import HardDrives from 'phosphor-astro/HardDrives.astro';
import Network from 'phosphor-astro/Network.astro';
import TrendUp from 'phosphor-astro/TrendUp.astro';
import Database from 'phosphor-astro/Database.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';

const title = 'Виртуализация серверов в Казани: Proxmox, VMware, Hyper-V | TechSupport';
const description = 'Виртуализация и миграция серверов в Казани и Татарстане: Proxmox VE, VMware vSphere, Hyper-V. Отказоустойчивые кластеры, резервное копирование Veeam. Экономия на железе до 50%.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Виртуализация серверов',
  provider: { '@type': 'LocalBusiness', name: 'TechSupport', url: 'https://out-techsupport.ru' },
  areaServed: [
    { '@type': 'City', name: 'Казань' },
    { '@type': 'State', name: 'Республика Татарстан' },
  ],
};
---

<Layout title={title} description={description} schema={serviceSchema}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Услуги', href: '/#services' }, { label: 'Виртуализация' }]} />
  </div>
  <ServiceHero
    title="Виртуализация"
    lead="Пять физических серверов превращаются в один мощный хост - с запасом под рост и восстановлением за минуты вместо дней. Строим виртуализацию на Proxmox, VMware и Hyper-V: миграция работающих серверов без переустановки, отказоустойчивые кластеры, резервное копирование. Замена облака на собственные серверы сокращает расходы на инфраструктуру до 50%."
    features={[
      { icon: Cpu, label: 'Экономия на железе', desc: '5 серверов → 1 хост с виртуалками, сокращение затрат на электричество и обслуживание.' },
      { icon: HardDrives, label: 'Снимки и откат', desc: 'Мгновенные снапшоты перед обновлениями, откат за минуты, а не за дни.' },
      { icon: Network, label: 'Отказоустойчивые кластеры', desc: 'Автоматический перезапуск VM на резервном хосте при отказе железа.' },
      { icon: TrendUp, label: 'Масштабирование без покупки', desc: 'Новый сервис = новая VM, без заказа и ожидания поставки железа.' },
    ]}
  />

  <Included
    heading="Что входит"
    intro="Работаем со всеми тремя основными платформами виртуализации. Выбор - за задачей и бюджетом, а не за вендором."
    items={[
      { icon: Cpu, title: 'Выбор платформы', desc: 'Hyper-V / VMware vSphere / Proxmox VE - подбор под задачи и бюджет, честное сравнение с плюсами и минусами.' },
      { icon: HardDrives, title: 'Миграция с физических серверов', desc: 'P2V-миграция рабочих серверов без простоя или с минимальным окном обслуживания.' },
      { icon: Network, title: 'Отказоустойчивые кластеры', desc: 'HA-кластеры на 2+ хоста, общее хранилище, автоматическое переключение VM при сбоях.' },
      { icon: Database, title: 'Хранилища и СХД', desc: 'Настройка NAS/SAN, iSCSI, NFS, репликация между площадками.' },
      { icon: ShieldCheck, title: 'Резервное копирование', desc: 'Veeam Backup, Proxmox Backup Server - инкрементальные копии и репликация VM.' },
      { icon: TrendUp, title: 'Мониторинг и планирование', desc: 'Отслеживание нагрузки по CPU / RAM / IO, планирование расширения до того, как ресурсы закончатся.' },
    ]}
  />

  <ForWhom
    heading="Кому подходит"
    intro="Виртуализация окупается уже на 3-5 серверах - либо за счёт экономии на железе, либо за счёт отказоустойчивости."
    scenarios={[
      { title: 'Компаниям с 3+ серверами', desc: 'Консолидация в 1-2 мощных хоста, экономия на электричестве и серверной, упрощение обслуживания.' },
      { title: 'Тем, кто обновляет железо', desc: 'Покупка нового сервера - повод мигрировать всё на виртуалки и получить отказоустойчивость заодно.' },
      { title: 'Компаниям с требованиями к DR', desc: 'Репликация виртуалок между площадками - при отказе основной запускаются на резервной за минуты.' },
      { title: 'Разработке и тестированию', desc: 'Быстрое развёртывание тестовых стендов, клонирование prod в test, сброс к чистому состоянию.' },
    ]}
  />

  <Process
    intro="От аудита до запуска продуктива - от 2 до 6 недель в зависимости от размера инфраструктуры."
    steps={[
      { title: 'Аудит инфраструктуры', desc: 'Инвентаризация серверов, нагрузок, требований к доступности и бюджета.' },
      { title: 'Выбор платформы и проект', desc: 'Сравнение Hyper-V / VMware / Proxmox под задачи, расчёт оборудования и лицензий.' },
      { title: 'Миграция', desc: 'Поэтапный перенос сервисов на виртуальную платформу, тестирование, переключение в окно обслуживания.' },
      { title: 'Сопровождение', desc: 'Мониторинг кластера, бэкапы, обновления хостов, планирование расширения.' },
    ]}
  />

  <FAQ
    items={[
      { q: 'Какую платформу выбрать?', a: 'Hyper-V хорош, если уже есть Windows Server Datacenter. VMware - промышленный стандарт, но дорогой в лицензировании. Proxmox - open-source, без лицензий, подходит для большинства задач. После аудита предложим 2 варианта с плюсами и минусами.' },
      { q: 'Можно мигрировать старые серверы без переустановки?', a: 'Да. P2V-миграция (physical to virtual) - переносим работающий Windows или Linux сервер в виртуалку. Обычно окно простоя 1-3 часа ночью или в выходные.' },
      { q: 'Что если хост-сервер выйдет из строя?', a: 'На одиночном хосте - восстановление из бэкапа, 1-4 часа в зависимости от размера. На HA-кластере - автоматическое переключение VM на резервный хост, простой 1-3 минуты.' },
      { q: 'Сколько стоит виртуализация?', a: 'Proxmox - только стоимость железа и работ. Hyper-V - бесплатен отдельно или уже включён в Windows Server Datacenter. VMware vSphere - от 300 000 ₽ за Essentials Plus на 3 хоста. Работы по миграции - от 40 000 ₽.' },
      { q: 'Что с 1С на виртуалке?', a: '1С отлично работает в виртуалке при правильной настройке: выделенные ядра, гарантированный RAM, SSD-хранилище. Снижения производительности относительно физического сервера нет.' },
      { q: 'Как с лицензиями Windows на виртуалках?', a: 'Windows Server Standard - 2 VM на физическом хосте, Datacenter - неограниченно. Разбираемся с лицензионной моделью и подсказываем оптимальный вариант под ваши нагрузки.' },
    ]}
  />

  <FinalCTA
    heading="Переведите серверы на виртуализацию"
    text="Проанализируем текущую инфраструктуру, покажем сколько можно сэкономить на железе и как получить отказоустойчивость. Аудит - бесплатно."
    primary={{ label: 'Заказать аудит серверов', href: '#contacts' }}
    secondary={{ label: 'Посмотреть тарифы', href: '/#prices' }}
  />

  <Contacts />

  <RelatedServices currentSlug="virtualization" />
</Layout>
