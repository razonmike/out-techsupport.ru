---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import Included from '../../components/service/Included.astro';
import ForWhom from '../../components/service/ForWhom.astro';
import Process from '../../components/service/Process.astro';
import FAQ from '../../components/service/FAQ.astro';
import FinalCTA from '../../components/service/FinalCTA.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';
import Breadcrumbs from '../../components/service/Breadcrumbs.astro';
import Contacts from '../../components/Contacts.astro';

import Lightning from 'phosphor-astro/Lightning.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';
import TrendUp from 'phosphor-astro/TrendUp.astro';
import HardDrives from 'phosphor-astro/HardDrives.astro';
import Network from 'phosphor-astro/Network.astro';
import Desktop from 'phosphor-astro/Desktop.astro';
import Clock from 'phosphor-astro/Clock.astro';

const title = 'DevOps-услуги в Казани: Docker, CI/CD, Kubernetes | TechSupport';
const description = 'DevOps для бизнеса в Казани и Татарстане: контейнеризация Docker, конвейеры CI/CD, Kubernetes, мониторинг Prometheus/Grafana. Автоматизация выпуска и эксплуатации сервисов.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'DevOps-услуги',
  provider: { '@type': 'LocalBusiness', name: 'TechSupport', url: 'https://out-techsupport.ru' },
  areaServed: [
    { '@type': 'City', name: 'Казань' },
    { '@type': 'State', name: 'Республика Татарстан' },
  ],
};
---

<Layout title={title} description={description} schema={serviceSchema}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Услуги', href: '/#services' }, { label: 'DevOps' }]} />
  </div>
  <ServiceHero
    title="DevOps"
    lead="Автоматизация выпуска и эксплуатации ваших сервисов: контейнеры, CI/CD, Kubernetes, мониторинг. Настраиваем процессы так, чтобы обновления выходили быстро и предсказуемо, а о проблемах вы узнавали раньше пользователей."
    features={[
      { icon: Lightning, label: 'Быстрые релизы', desc: 'Выкладка обновлений без ручных операций и ночных авралов.' },
      { icon: ShieldCheck, label: 'Предсказуемость', desc: 'Тестовый контур и автоматические проверки до продакшена.' },
      { icon: TrendUp, label: 'Мониторинг', desc: 'Метрики и алерты: о проблеме узнаём до того, как её заметят пользователи.' },
      { icon: HardDrives, label: 'Контейнеры', desc: 'Сервисы в Docker: изоляция, быстрый перенос и восстановление.' },
    ]}
  />

  <Included
    heading="Что входит"
    intro="От упаковки сервисов в контейнеры до сопровождения готовой инфраструктуры."
    items={[
      { icon: HardDrives, title: 'Контейнеризация на Docker', desc: 'Упаковка сервисов в контейнеры: одинаковое окружение везде, быстрый перенос между серверами, восстановление за минуты.' },
      { icon: Lightning, title: 'Конвейеры CI/CD', desc: 'Автоматическая сборка, проверки и выкладка: GitLab CI, GitHub Actions. От изменения в коде до продакшена без ручных шагов.' },
      { icon: Network, title: 'Kubernetes', desc: 'Развёртывание и сопровождение кластеров: отказоустойчивость, масштабирование, обновления без простоя.' },
      { icon: TrendUp, title: 'Мониторинг и алертинг', desc: 'Prometheus, Grafana, сбор логов: состояние сервисов видно в реальном времени, алерты приходят до сбоя.' },
      { icon: Desktop, title: 'Инфраструктура как код', desc: 'Конфигурация серверов и окружений хранится в коде: изменения прозрачны, откат быстрый, ничего не держится на памяти одного человека.' },
      { icon: Clock, title: 'Сопровождение', desc: 'Дежурный мониторинг, обновления, резервные копии и разбор инцидентов в рамках абонентского обслуживания.' },
    ]}
  />

  <ForWhom
    heading="Кому подходит"
    intro="DevOps нужен не только большим: ручная выкладка ломает сервисы и в компании с одним сервером."
    scenarios={[
      { title: 'Компаниям с собственными сервисами', desc: 'Внутренние порталы, API, интернет-магазины: нужен стабильный выпуск обновлений без простоев и сюрпризов.' },
      { title: 'Разработке без своего DevOps', desc: 'Команда пишет код, а собирать, выкладывать и мониторить некому. Берём эксплуатацию на себя.' },
      { title: 'Тем, кто уходит из облака', desc: 'Переносим сервисы с облачных платформ на собственные серверы с виртуализацией - дешевле и под вашим контролем.' },
      { title: 'Растущим проектам', desc: 'Нагрузка растёт: настраиваем масштабирование и отказоустойчивость до того, как сервис начнёт падать.' },
    ]}
  />

  <Process
    intro="Начинаем с аудита: как сейчас собирается, выкладывается и мониторится продукт."
    steps={[
      { title: 'Аудит', desc: 'Разбираем текущие процессы и инфраструктуру, находим узкие места и ручные операции.' },
      { title: 'План', desc: 'Предлагаем целевую схему: контейнеры, конвейер, мониторинг - с приоритетами и этапами.' },
      { title: 'Внедрение', desc: 'Автоматизируем поэтапно: сначала критичное, без остановки текущей работы.' },
      { title: 'Сопровождение', desc: 'Поддерживаем конвейер и инфраструктуру, развиваем под новые задачи.' },
    ]}
  />

  <FAQ
    items={[
      { q: 'У нас один сервер и пара сервисов - нам нужен DevOps?', a: 'Если обновления выкладываются вручную и после них периодически что-то ломается - да. Даже на одном сервере контейнеры, автоматическая выкладка и мониторинг убирают большую часть ручных ошибок.' },
      { q: 'Что такое CI/CD простыми словами?', a: 'Конвейер, который сам собирает приложение из кода, прогоняет проверки и выкладывает на сервер. Разработчик сохраняет изменения - через несколько минут они в работе, без ручных операций и «забыли скопировать файл».' },
      { q: 'Нужен ли нам Kubernetes?', a: 'Не всегда. Для пары сервисов достаточно Docker и простого конвейера. Kubernetes оправдан, когда сервисов много и нужны отказоустойчивость и масштабирование. Честно скажем, если вам он не нужен.' },
      { q: 'Вы работаете с нашими разработчиками или вместо них?', a: 'Вместе. Разработка остаётся за вашей командой или подрядчиком, мы закрываем инфраструктуру: окружения, выкладку, мониторинг, резервные копии.' },
      { q: 'Можно перенести сервисы из облака на свои серверы?', a: 'Да, это одна из типовых задач: разворачиваем виртуализацию на вашем оборудовании и переносим сервисы. Часто это заметно дешевле облака на горизонте года.' },
      { q: 'Что с поддержкой после внедрения?', a: 'Инфраструктура подключается к нашему мониторингу, сопровождение идёт в рамках абонентского обслуживания вместе с остальной IT-инфраструктурой компании.' },
    ]}
  />

  <FinalCTA
    heading="Наведите порядок в выпуске и эксплуатации"
    text="Разберём, как сейчас устроены сборка, выкладка и мониторинг ваших сервисов, и предложим план автоматизации. Консультация - бесплатно."
    primary={{ label: 'Обсудить задачу', href: '#contacts' }}
    secondary={{ label: 'Посмотреть тарифы', href: '/#prices' }}
  />

  <Contacts />

  <RelatedServices currentSlug="devops" />
</Layout>
