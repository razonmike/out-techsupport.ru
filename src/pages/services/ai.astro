---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import Included from '../../components/service/Included.astro';
import ForWhom from '../../components/service/ForWhom.astro';
import Process from '../../components/service/Process.astro';
import FAQ from '../../components/service/FAQ.astro';
import FinalCTA from '../../components/service/FinalCTA.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';
import Breadcrumbs from '../../components/service/Breadcrumbs.astro';
import Contacts from '../../components/Contacts.astro';

import Headphones from 'phosphor-astro/Headphones.astro';
import Lightning from 'phosphor-astro/Lightning.astro';
import UserGear from 'phosphor-astro/UserGear.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';
import Database from 'phosphor-astro/Database.astro';
import Network from 'phosphor-astro/Network.astro';
import TrendUp from 'phosphor-astro/TrendUp.astro';
import CheckCircle from 'phosphor-astro/CheckCircle.astro';

const title = 'Внедрение AI в бизнес в Казани | TechSupport';
const description = 'Внедрение AI в бизнес-процессы в Казани и Татарстане: ассистенты и чат-боты, обработка документов и заявок, AI-агенты, обучение сотрудников. Начинаем с пилота на одной задаче.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Внедрение AI в бизнес-процессы',
  provider: { '@type': 'LocalBusiness', name: 'TechSupport', url: 'https://out-techsupport.ru' },
  areaServed: [
    { '@type': 'City', name: 'Казань' },
    { '@type': 'State', name: 'Республика Татарстан' },
  ],
};
---

<Layout title={title} description={description} schema={serviceSchema}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Услуги', href: '/#services' }, { label: 'Внедрение AI' }]} />
  </div>
  <ServiceHero
    title="Внедрение AI"
    lead="Помогаем бизнесу использовать AI там, где он реально экономит время: ассистенты для клиентов и сотрудников, обработка документов и заявок, AI-агенты в рабочих процессах. Сами работаем с AI-инструментами каждый день - внедряем то, что проверили на себе."
    features={[
      { icon: Headphones, label: 'Ассистенты и чат-боты', desc: 'Отвечают на типовые вопросы клиентов и сотрудников - люди занимаются сложными.' },
      { icon: Lightning, label: 'Автоматизация рутины', desc: 'Документы, письма и заявки обрабатываются без ручного разбора.' },
      { icon: UserGear, label: 'AI-агенты в процессах', desc: 'Агенты, встроенные в работу: от первичной поддержки до подготовки отчётов.' },
      { icon: ShieldCheck, label: 'Данные под контролем', desc: 'Прорабатываем, какие данные можно отдавать модели, а какие остаются внутри компании.' },
    ]}
  />

  <Included
    heading="Что входит"
    intro="От аудита процессов до работающего решения и обученных сотрудников."
    items={[
      { icon: Headphones, title: 'AI-ассистенты и чат-боты', desc: 'Ассистенты на современных языковых моделях: поддержка клиентов, ответы по базе знаний компании, приём заявок.' },
      { icon: Database, title: 'Обработка документов', desc: 'Разбор входящих документов, писем и заявок: данные попадают в учётные системы без ручного ввода.' },
      { icon: UserGear, title: 'AI-агенты', desc: 'Агенты для многошаговых задач: подготовка отчётов, первичная диагностика обращений, рутинные операции по расписанию.' },
      { icon: Network, title: 'Интеграция с вашими системами', desc: 'Подключаем AI к 1С, CRM, почте и мессенджерам - работает внутри привычных инструментов, а не в отдельном окне.' },
      { icon: TrendUp, title: 'Аудит и подбор инструментов', desc: 'Разбираем процессы компании и показываем, где AI окупится, а где это дань моде и трата денег.' },
      { icon: CheckCircle, title: 'Обучение сотрудников', desc: 'Учим команду работать с AI: что можно делегировать, как проверять результат, чему не стоит доверять.' },
    ]}
  />

  <ForWhom
    heading="Кому подходит"
    intro="AI окупается там, где есть поток однотипной работы с текстом, документами и обращениями."
    scenarios={[
      { title: 'Компаниям с потоком обращений', desc: 'Клиенты задают одни и те же вопросы. Ассистент отвечает мгновенно и круглосуточно, люди подключаются к сложным случаям.' },
      { title: 'Бизнесу с бумажной рутиной', desc: 'Счета, накладные и договоры разбираются вручную. AI вытаскивает данные и заносит их в учётную систему.' },
      { title: 'Руководителям, которые присматриваются', desc: 'Понимаете, что AI нужен, но не понимаете, с чего начать. Аудит покажет 2-3 точки с самой быстрой окупаемостью.' },
      { title: 'Командам, которым нужно обучение', desc: 'Инструменты куплены, но сотрудники ими не пользуются. Учим на реальных задачах вашей компании.' },
    ]}
  />

  <Process
    intro="Начинаем с малого: одна задача, измеримый результат - и только потом масштабирование."
    steps={[
      { title: 'Аудит процессов', desc: 'Смотрим, где сотрудники тратят время на рутину, которую может взять на себя AI.' },
      { title: 'Пилот', desc: 'Выбираем одну задачу и делаем рабочее решение: быстро видно, окупается или нет.' },
      { title: 'Внедрение', desc: 'Встраиваем в рабочие процессы и системы, настраиваем доступы и контроль качества ответов.' },
      { title: 'Обучение и развитие', desc: 'Учим сотрудников, расширяем на соседние задачи, сопровождаем.' },
    ]}
  />

  <FAQ
    items={[
      { q: 'Это безопасно? Куда уходят наши данные?', a: 'Зависит от решения. Проектируем так, чтобы чувствительные данные не покидали компанию: локальные модели на вашем сервере или строгие правила, что можно отправлять во внешние сервисы. Это первый вопрос, который прорабатываем на аудите.' },
      { q: 'AI не будет выдумывать ответы клиентам?', a: 'Будет, если внедрить без контроля. Поэтому ассистенты отвечают только по базе знаний компании, а в спорных случаях передают диалог человеку. Качество ответов проверяем до запуска, а не после жалоб.' },
      { q: 'С какими моделями работаете?', a: 'Подбираем под задачу и требования к данным: облачные модели (Claude, GPT, YandexGPT, GigaChat) или локальные, развёрнутые на вашем оборудовании.' },
      { q: 'У нас нет своих разработчиков - потянем?', a: 'Да, это типовая ситуация для наших клиентов. Внедряем, интегрируем и сопровождаем сами - сотрудникам остаётся пользоваться.' },
      { q: 'С чего начать?', a: 'С аудита: за одну-две встречи покажем, где в ваших процессах AI окупится быстрее всего, и предложим пилот на одной задаче.' },
      { q: 'Сколько это стоит?', a: 'Зависит от задачи: пилот на одном процессе - это недели, а не месяцы работы. Оценку даём после аудита. Аудит - бесплатно.' },
    ]}
  />

  <FinalCTA
    heading="Найдите, где AI окупится в вашем бизнесе"
    text="Разберём ваши процессы и покажем 2-3 задачи, где AI даст эффект быстрее всего. Аудит - бесплатно."
    primary={{ label: 'Обсудить внедрение AI', href: '#contacts' }}
    secondary={{ label: 'Посмотреть тарифы', href: '/#prices' }}
  />

  <Contacts />

  <RelatedServices currentSlug="ai" />
</Layout>
