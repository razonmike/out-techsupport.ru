---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import Included from '../../components/service/Included.astro';
import ForWhom from '../../components/service/ForWhom.astro';
import Process from '../../components/service/Process.astro';
import FAQ from '../../components/service/FAQ.astro';
import FinalCTA from '../../components/service/FinalCTA.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';
import Breadcrumbs from '../../components/service/Breadcrumbs.astro';
import Contacts from '../../components/Contacts.astro';

import Network from 'phosphor-astro/Network.astro';
import PaperPlaneTilt from 'phosphor-astro/PaperPlaneTilt.astro';
import Desktop from 'phosphor-astro/Desktop.astro';
import UserGear from 'phosphor-astro/UserGear.astro';
import Lightning from 'phosphor-astro/Lightning.astro';
import Database from 'phosphor-astro/Database.astro';
import Clock from 'phosphor-astro/Clock.astro';

const title = 'Разработка ПО для бизнеса в Казани: интеграции, боты, веб | TechSupport';
const description = 'Разработка ПО под задачи бизнеса в Казани и Татарстане: интеграции с 1С, Telegram-боты, веб-приложения, доработка open source решений. Автоматизация ручной рутины.';

const serviceSchema = {
  '@context': 'https://schema.org',
  '@type': 'Service',
  serviceType: 'Разработка программного обеспечения',
  provider: { '@type': 'LocalBusiness', name: 'TechSupport', url: 'https://out-techsupport.ru' },
  areaServed: [
    { '@type': 'City', name: 'Казань' },
    { '@type': 'State', name: 'Республика Татарстан' },
  ],
};
---

<Layout title={title} description={description} schema={serviceSchema}>
  <div class="container">
    <Breadcrumbs items={[{ label: 'Главная', href: '/' }, { label: 'Услуги', href: '/#services' }, { label: 'Разработка ПО' }]} />
  </div>
  <ServiceHero
    title="Разработка ПО"
    lead="Разрабатываем то, что ускоряет работу компании: интеграции между системами, Telegram-боты, веб-приложения и доработка готового ПО. Прикладные задачи, которые крупным студиям неинтересны, а бизнесу нужны каждый день."
    features={[
      { icon: Network, label: 'Интеграции', desc: 'Связываем системы между собой: 1С, сайты, CRM и склады обмениваются данными сами.' },
      { icon: PaperPlaneTilt, label: 'Telegram-боты', desc: 'Заявки, уведомления, отчёты и внутренние процессы - в привычном мессенджере.' },
      { icon: Desktop, label: 'Веб-приложения', desc: 'Личные кабинеты, внутренние инструменты, корпоративные сайты.' },
      { icon: UserGear, label: 'Доработка готового ПО', desc: 'Адаптируем open source решения под процессы компании.' },
    ]}
  />

  <Included
    heading="Что входит"
    intro="От скрипта, который убирает час ручной работы в день, до веб-приложения под процессы компании."
    items={[
      { icon: Lightning, title: 'Автоматизация рутины', desc: 'Скрипты и сервисы, которые убирают ручные операции: выгрузки, конвертация документов, рассылки, перенос данных между системами.' },
      { icon: Database, title: 'Обмены с 1С', desc: 'Интеграция 1С с сайтами, сервисами и внешними системами: заказы, остатки, документы попадают куда нужно без ручного ввода.' },
      { icon: PaperPlaneTilt, title: 'Telegram-боты', desc: 'От бота приёма заявок до интеграции с внутренними системами: уведомления о событиях, отчёты, управление процессами.' },
      { icon: Desktop, title: 'Веб-разработка', desc: 'Сайты и веб-приложения под задачи бизнеса: быстрые, без лишних зависимостей, с понятной дальнейшей поддержкой.' },
      { icon: UserGear, title: 'Доработка open source', desc: 'Берём готовое открытое решение и дорабатываем под компанию - быстрее и дешевле разработки с нуля.' },
      { icon: Clock, title: 'Сопровождение', desc: 'Написанное нами ПО поддерживаем и развиваем в рамках абонентского обслуживания.' },
    ]}
  />

  <ForWhom
    heading="Кому подходит"
    intro="Чаще всего к нам приходят не за «программой», а за тем, чтобы убрать ручную работу из процесса."
    scenarios={[
      { title: 'Компаниям, где много ручной работы', desc: 'Сотрудники переносят данные между системами вручную, собирают отчёты копированием. Автоматизация таких задач окупается за месяцы.' },
      { title: 'Бизнесу с 1С', desc: 'Нужно связать 1С с сайтом, доставкой, маркетплейсом или внутренним сервисом - без ручных выгрузок.' },
      { title: 'Тем, кому не подходит коробка', desc: 'Готовые сервисы не ложатся на процессы компании. Дорабатываем открытые решения или пишем своё.' },
      { title: 'Нашим абонентским клиентам', desc: 'Разработка от подрядчика, который уже знает вашу инфраструктуру изнутри - без долгого ввода в контекст.' },
    ]}
  />

  <Process
    intro="Работаем итерациями: сначала минимальная рабочая версия, потом развитие."
    steps={[
      { title: 'Постановка задачи', desc: 'Разбираем процесс, который нужно автоматизировать, и фиксируем результат, который нужен бизнесу.' },
      { title: 'Оценка и план', desc: 'Предлагаем вариант решения: готовое ПО, доработка открытого или разработка - с оценкой объёма работ.' },
      { title: 'Разработка', desc: 'Делаем рабочую версию, показываем, собираем замечания, доводим до результата.' },
      { title: 'Запуск и поддержка', desc: 'Внедряем, обучаем сотрудников, сопровождаем и развиваем под новые задачи.' },
    ]}
  />

  <FAQ
    items={[
      { q: 'Какого размера задачи берёте?', a: 'От скрипта на день работы до веб-приложения на несколько месяцев. За то, что требует большой продуктовой команды, не берёмся - честно скажем об этом на этапе оценки.' },
      { q: 'На чём пишете?', a: 'Python, JavaScript/TypeScript, при необходимости Rust. Для ботов - проверенные фреймворки, для веба - современный стек без избыточных технологий, чтобы решение было дёшево поддерживать.' },
      { q: 'Можете доработать чужой код?', a: 'Да, если код в адекватном состоянии. Сначала смотрим проект и честно оцениваем: дорабатывать или дешевле переписать конкретный модуль.' },
      { q: 'Кто будет поддерживать решение потом?', a: 'Мы. Написанное сопровождаем в рамках абонентского обслуживания: исправления, обновления, развитие под новые задачи. Не бросаем после сдачи.' },
      { q: 'Передаёте ли исходный код?', a: 'Да. Код и документация - собственность заказчика. Никакой привязки к нам как к единственному возможному подрядчику.' },
      { q: 'Сколько стоит разработка?', a: 'Зависит от задачи. После постановки задачи даём оценку объёма и фиксируем стоимость этапа до начала работ. Постановка задачи и оценка - бесплатно.' },
    ]}
  />

  <FinalCTA
    heading="Автоматизируйте ручную работу"
    text="Расскажите, какую рутину хотите убрать - предложим способ решения и оценку. Консультация - бесплатно."
    primary={{ label: 'Обсудить задачу', href: '#contacts' }}
    secondary={{ label: 'Посмотреть тарифы', href: '/#prices' }}
  />

  <Contacts />

  <RelatedServices currentSlug="software-development" />
</Layout>
