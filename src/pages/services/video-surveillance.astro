---
import Layout from '../../layouts/Layout.astro';
import ServiceHero from '../../components/service/ServiceHero.astro';
import Included from '../../components/service/Included.astro';
import ForWhom from '../../components/service/ForWhom.astro';
import Process from '../../components/service/Process.astro';
import FAQ from '../../components/service/FAQ.astro';
import FinalCTA from '../../components/service/FinalCTA.astro';
import RelatedServices from '../../components/service/RelatedServices.astro';
import Contacts from '../../components/Contacts.astro';

import VideoCamera from 'phosphor-astro/VideoCamera.astro';
import HardDrives from 'phosphor-astro/HardDrives.astro';
import LockKey from 'phosphor-astro/LockKey.astro';
import Headphones from 'phosphor-astro/Headphones.astro';
import Network from 'phosphor-astro/Network.astro';
import ShieldCheck from 'phosphor-astro/ShieldCheck.astro';
import Clock from 'phosphor-astro/Clock.astro';

const title = 'Видеонаблюдение и СКД для бизнеса | TechSupport Казань';
const description = 'Установка и обслуживание систем видеонаблюдения и контроля доступа: IP-камеры, турникеты, распознавание лиц, интеграция с 1С:ЗУП.';
---

<Layout title={title} description={description}>
  <ServiceHero
    kicker="Видеонаблюдение и СКД"
    title="Видеонаблюдение и контроль доступа под задачи бизнеса"
    lead="Проектируем и устанавливаем системы видеонаблюдения и СКД для офисов, складов, ритейла и производств. От 4 камер и одного турникета до сотен точек с распознаванием лиц и интеграцией в 1С по учёту рабочего времени."
    features={[
      { icon: VideoCamera, label: 'Покрытие ключевых точек', desc: 'Подбор камер под задачу: уличные, купольные, PTZ, с распознаванием.' },
      { icon: HardDrives, label: 'Хранение на ваших условиях', desc: 'Локальный NVR или облако, срок хранения архива 7-90 дней.' },
      { icon: LockKey, label: 'Доступ по картам и биометрии', desc: 'Турникеты, электрозамки, интеграция с учётом рабочего времени.' },
      { icon: Headphones, label: 'Удалённый просмотр', desc: 'Просмотр архива с ПК и телефона, уведомления о движении.' },
    ]}
  />

  <Included
    heading="Что входит"
    intro="Полный цикл: от выезда на объект до сопровождения готовой системы."
    items={[
      { icon: VideoCamera, title: 'Подбор и монтаж камер', desc: 'IP или аналог, PoE-питание, всепогодные модели для улицы, купольные для помещений.' },
      { icon: HardDrives, title: 'Регистраторы и хранение', desc: 'NVR с рассчитанным объёмом дисков, облачное хранение как опция, резервирование архива.' },
      { icon: LockKey, title: 'Системы контроля доступа', desc: 'Турникеты, электрозамки, карточные и биометрические считыватели, интеграция с 1С:ЗУП.' },
      { icon: Network, title: 'Сетевая инфраструктура', desc: 'Отдельный VLAN под камеры, PoE-коммутаторы, защита от перегруза основной сети.' },
      { icon: ShieldCheck, title: 'Распознавание лиц и номеров', desc: 'Опция для ритейла и парковок: аналитика по посетителям, контроль входа по базе.' },
      { icon: Clock, title: 'Сопровождение', desc: 'Мониторинг работоспособности камер, проверка архива, замена вышедшего из строя оборудования.' },
    ]}
  />

  <ForWhom
    heading="Кому подходит"
    intro="Систему собираем под конкретные задачи: кражи, контроль персонала, учёт посетителей, безопасность."
    scenarios={[
      { title: 'Ритейлу и HoReCa', desc: 'Профилактика краж и конфликтов, разбор спорных ситуаций с клиентами, контроль кассовых операций.' },
      { title: 'Складам и логистике', desc: 'Контроль погрузочно-разгрузочных работ, фиксация приёма товара, мониторинг въезда транспорта.' },
      { title: 'Офисам и БЦ', desc: 'Контроль доступа на этажи, запись входа-выхода посетителей, учёт рабочего времени сотрудников.' },
      { title: 'Производствам и стройкам', desc: 'Удалённый мониторинг площадок, фиксация нарушений ТБ, защита от несанкционированного доступа.' },
    ]}
  />

  <Process
    intro="От первого выезда до сдачи объекта - обычно 1-3 недели в зависимости от масштаба."
    steps={[
      { title: 'Осмотр объекта', desc: 'Выезжаем, определяем точки наблюдения и прохода, уточняем задачи.' },
      { title: 'Проект', desc: 'Схема размещения, спецификация оборудования, 2-3 варианта по бюджету и сроку архива.' },
      { title: 'Монтаж', desc: 'Прокладка кабеля, установка камер и СКД, настройка регистратора, удалённый доступ.' },
      { title: 'Запуск и обучение', desc: 'Передаём доступ, обучаем ответственного работе с архивом и СКД, сопровождаем первые недели.' },
    ]}
  />

  <FAQ
    items={[
      { q: 'Сколько стоит система на небольшой офис?', a: 'Базовая система на 4 камеры + регистратор с жёстким диском - от 45 000 ₽ с монтажом. Турникет с одним считывателем - от 80 000 ₽. Точный расчёт после выезда на объект.' },
      { q: 'Нужно ли заводить отдельную сеть для камер?', a: 'Для 4-8 камер можно использовать существующую сеть, если она не перегружена. От 10+ камер рекомендуем выделять отдельный VLAN или даже физически отдельные коммутаторы - иначе видеопоток будет мешать работе сотрудников.' },
      { q: 'Как долго хранится архив?', a: 'Стандартно 14-30 дней. Можно увеличить до 90 дней наращиванием дисков. Для критичных объектов настраиваем дублирование архива в облако или на удалённую площадку.' },
      { q: 'Есть ли распознавание лиц и номеров?', a: 'Да. Используем Hikvision DeepInMind, Dahua AI, отечественные аналоги. Решения бывают встроенные в камеры или серверные - подбираем под количество точек и задачи.' },
      { q: 'Работает ли СКД с 1С?', a: 'Да. Интегрируем ZKTeco, Sigur, Perco с 1С:ЗУП - учёт рабочего времени автоматически попадает в кадровый модуль без ручного ввода.' },
      { q: 'Можно смотреть архив удалённо?', a: 'Да, через мобильное приложение или веб-интерфейс регистратора. Доступ организуем через VPN или защищённый шлюз - архив не должен торчать в открытый интернет.' },
    ]}
  />

  <FinalCTA
    heading="Получите систему видеонаблюдения под ваши задачи"
    text="Выедем на объект, составим план расстановки камер и турникетов, дадим смету. Первичный выезд - бесплатно по Казани."
    primary={{ label: 'Заказать выезд специалиста', href: '#contacts' }}
    secondary={{ label: 'Посмотреть тарифы', href: '/#prices' }}
  />

  <Contacts />

  <RelatedServices currentSlug="video-surveillance" />
</Layout>
