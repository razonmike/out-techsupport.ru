---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  schema?: any;
}

const SITE_URL = 'https://out-techsupport.ru';

const {
  title = 'IT-аутсорсинг в Казани и Татарстане | TechSupport - внешний IT-отдел',
  description = 'Внешний IT-отдел для бизнеса. Абонентское IT-обслуживание: сеть, серверы, 1С, видеонаблюдение, резервное копирование. Казань и Татарстан с выездом, остальная Россия удалённо. С 2014 года, 25+ компаний на обслуживании.',
  ogImage = '/assets/images/og-default.png',
  ogType = 'website',
  schema,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, SITE_URL).href;
const ogImageAbsolute = new URL(ogImage, SITE_URL).href;

const localBusinessSchema = {
  '@context': 'https://schema.org',
  '@type': 'LocalBusiness',
  name: 'TechSupport',
  alternateName: 'ТехСаппорт',
  description: 'IT-аутсорсинг и абонентское обслуживание IT-инфраструктуры для бизнеса в Казани и Татарстане',
  url: SITE_URL,
  logo: new URL('/assets/images/logo-icon.svg', SITE_URL).href,
  image: ogImageAbsolute,
  telephone: '+7-965-609-31-53',
  email: 'support@out-techsupport.ru',
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Казань',
    addressRegion: 'Республика Татарстан',
    addressCountry: 'RU',
  },
  areaServed: [
    { '@type': 'City', name: 'Казань' },
    { '@type': 'State', name: 'Республика Татарстан' },
    { '@type': 'Country', name: 'Россия' },
  ],
  openingHoursSpecification: {
    '@type': 'OpeningHoursSpecification',
    dayOfWeek: ['Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday'],
    opens: '09:00',
    closes: '19:00',
  },
  priceRange: 'от 5 000 ₽/мес',
  foundingDate: '2014',
  sameAs: ['https://t.me/outtechsupport'],
};
---

<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <meta name="description" content={description}>
  <meta name="yandex-verification" content="b424a9da124cff01">
  <title>{title}</title>
  <link rel="canonical" href={canonical}>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <link rel="apple-touch-icon" href="/favicon.svg">

  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonical}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={ogImageAbsolute}>
  <meta property="og:site_name" content="TechSupport">
  <meta property="og:locale" content="ru_RU">

  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={ogImageAbsolute}>

  <script type="application/ld+json" set:html={JSON.stringify(localBusinessSchema)}></script>
  {schema && <script type="application/ld+json" set:html={JSON.stringify(schema)}></script>}

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600;700;800&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">
</head>
<body>
  <a class="skip-link" href="#top">Перейти к содержимому</a>
  <header class="site-header">
    <div class="container nav">
      <a class="brand" href="/">
        <img class="brand-icon" src="/assets/images/logo-icon.svg" alt="TechSupport logo">
        <span class="brand-copy">
          <span class="brand-text">TechSupport<span class="brand-cursor">_</span></span>
          <span class="brand-subtext">IT аутсорсинг вашего бизнеса</span>
        </span>
      </a>
      <nav class="menu" id="main-menu">
        <a href="/#services">Услуги</a>
        <a href="/#cases">Кейсы</a>
        <a href="/#prices">Тарифы</a>
        <a href="/#contacts">Контакты</a>
      </nav>
      <a class="btn btn-small btn-ghost nav-download" href="/downloads/TechSupport.exe" title="Клиент удалённого доступа TechSupport">
        <svg class="nav-download-icon" width="15" height="15" viewBox="0 0 256 256" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M224,152v56a16,16,0,0,1-16,16H48a16,16,0,0,1-16-16V152a8,8,0,0,1,16,0v56H208V152a8,8,0,0,1,16,0Zm-101.66,5.66a8,8,0,0,0,11.32,0l40-40a8,8,0,0,0-11.32-11.32L136,132.69V40a8,8,0,0,0-16,0v92.69L93.66,106.34a8,8,0,0,0-11.32,11.32Z"/></svg>
        <span class="nav-download-label">Скачать клиент</span>
      </a>
      <a class="btn btn-small nav-cta" href="/#contacts">Оставить заявку</a>
      <button
        class="nav-burger"
        id="nav-burger"
        type="button"
        aria-label="Меню"
        aria-expanded="false"
        aria-controls="main-menu"
      >
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
  </header>

  <main id="top">
    <slot />
  </main>

  <footer class="site-footer section-with-bg">
    <div class="container footer-inner">
      <a class="brand" href="/">
        <img class="brand-icon" src="/assets/images/logo-icon.svg" alt="TechSupport logo">
        <span class="brand-copy">
          <span class="brand-text">TechSupport<span class="brand-cursor">_</span></span>
          <span class="brand-subtext">IT аутсорсинг вашего бизнеса</span>
        </span>
      </a>
      <div class="footer-contacts">
        <a href="tel:+79656093153">+7 (965) 609-31-53</a>
        <a href="mailto:support@out-techsupport.ru">support@out-techsupport.ru</a>
        <span class="footer-geo">Казань · Татарстан · Россия удалённо</span>
        <a href="/downloads/TechSupport.exe" class="footer-download">Скачать клиент удалённого доступа</a>
        <a href="/privacy" class="footer-privacy">Политика обработки персональных данных</a>
      </div>
    </div>
  </footer>

  <script>
    (function () {
      var counters = document.querySelectorAll("[data-counter]");
      if (!counters.length) return;
      var reduced = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
      function animate(el) {
        var target = parseInt(el.getAttribute("data-target"), 10) || 0;
        var suffix = el.getAttribute("data-suffix") || "";
        if (reduced || target === 0) {
          el.textContent = target + suffix;
          return;
        }
        var duration = 1400;
        var start = performance.now();
        function tick(now) {
          var p = Math.min(1, (now - start) / duration);
          var eased = 1 - Math.pow(1 - p, 3);
          var v = Math.round(target * eased);
          el.textContent = v + suffix;
          if (p < 1) requestAnimationFrame(tick);
        }
        el.textContent = "0" + suffix;
        requestAnimationFrame(tick);
      }
      if (!("IntersectionObserver" in window)) {
        counters.forEach(animate);
        return;
      }
      var io = new IntersectionObserver(function (entries, obs) {
        entries.forEach(function (e) {
          if (!e.isIntersecting) return;
          animate(e.target);
          obs.unobserve(e.target);
        });
      }, { threshold: 0.3 });
      counters.forEach(function (c) { io.observe(c); });
    })();
  </script>

  <script>
    (function () {
      var revealItems = document.querySelectorAll(".reveal");
      if (!revealItems.length) return;
      if (!("IntersectionObserver" in window)) {
        revealItems.forEach(function (item) { item.classList.add("is-visible"); });
        return;
      }
      var observer = new IntersectionObserver(
        function (entries, obs) {
          entries.forEach(function (entry) {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            obs.unobserve(entry.target);
          });
        },
        { threshold: 0.2, rootMargin: "0px 0px -8% 0px" }
      );
      revealItems.forEach(function (item, index) {
        item.style.transitionDelay = Math.min(index * 40, 280) + "ms";
        observer.observe(item);
      });
    })();
  </script>

  <script>
    (function () {
      var burger = document.getElementById("nav-burger");
      var menu = document.getElementById("main-menu");
      if (!burger || !menu) return;

      function closeMenu() {
        menu.classList.remove("is-open");
        burger.classList.remove("is-open");
        burger.setAttribute("aria-expanded", "false");
        document.body.classList.remove("nav-lock");
      }

      function toggleMenu() {
        var isOpen = menu.classList.toggle("is-open");
        burger.classList.toggle("is-open", isOpen);
        burger.setAttribute("aria-expanded", isOpen ? "true" : "false");
        document.body.classList.toggle("nav-lock", isOpen);
      }

      burger.addEventListener("click", toggleMenu);
      menu.querySelectorAll("a").forEach(function (link) {
        link.addEventListener("click", closeMenu);
      });

      window.addEventListener("resize", function () {
        if (window.innerWidth > 980) closeMenu();
      });
    })();
  </script>
</body>
</html>
